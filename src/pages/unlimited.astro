---
/**
 * Unlimited rounds. A new set every time, separate from the daily streak.
 */
import LocaleLayout from '~/components/layout/LocaleLayout.astro';
import GameApp from '~/components/game/GameApp.astro';
import RelatedLinks from '~/components/game/RelatedLinks.astro';
import { UNLIMITED } from '~/lib/game/copy';
import { CATEGORY_PAGE_LIST } from '~/lib/game/category-copy';
import { site, siteUrl } from '~/config/site';
import { defaultLocale, locales } from '~/i18n/routing';
import { simpleBreadcrumbJsonLd, videoGameJsonLd } from '~/lib/seo';
import { languageAlternates, localizePath } from '~/lib/url';

const locale = defaultLocale;
const path = localizePath('/unlimited/', locale);
const alternates = languageAlternates((loc) => localizePath('/unlimited/', loc), locales);
const webApp: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Rarest Answer Unlimited',
  url: `${siteUrl}/unlimited/`,
  applicationCategory: 'GameApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  isAccessibleForFree: true,
  description: UNLIMITED.description,
  inLanguage: 'en',
};
const jsonLd: Record<string, unknown>[] = [
  videoGameJsonLd(),
  webApp,
  simpleBreadcrumbJsonLd({
    pageLabel: UNLIMITED.h1,
    path,
    locale,
    homeLabel: 'Home',
  }),
];
const links = [
  { href: '/', label: `Play today's ${site.game.name} daily` },
  ...CATEGORY_PAGE_LIST.map((page) => ({ href: `/trivia/${page.key}/`, label: page.h1 })),
  { href: '/games/games-like-krillion/', label: 'Games like Krillion' },
  { href: '/guides/how-to-find-rare-answers/', label: 'How to find rare answers' },
  { href: '/rarest-answers/', label: 'Browse the rarest answers' },
];
---

<LocaleLayout
  locale={locale}
  title={UNLIMITED.title}
  description={UNLIMITED.description}
  alternates={alternates}
  jsonLd={jsonLd}
  fullBleed
>
  <div data-pagefind-body>
    <header class="mx-auto max-w-3xl px-4 pt-6 sm:pt-10">
      <p class="text-sm font-semibold text-nav">{UNLIMITED.kicker}</p>
      <h1 class="mt-2 text-balance text-3xl font-black tracking-tight text-foreground sm:text-4xl">
        {UNLIMITED.h1}
      </h1>
      <p class="mt-3 max-w-2xl text-base text-foreground sm:text-lg">{UNLIMITED.intro}</p>
    </header>
  </div>

  <div class="mx-auto mt-6 max-w-3xl px-4">
    <GameApp mode="unlimited">
      <a slot="end" class="btn-outline flex h-12 w-full items-center justify-center" href="/">
        Back to the daily
      </a>
    </GameApp>
  </div>

  <div data-pagefind-body class="mx-auto max-w-3xl px-4 pb-16">
    <section class="mt-16">
      <h2 class="text-2xl font-bold tracking-tight text-foreground">When to play unlimited</h2>
      <p class="mt-3 text-foreground">
        Finish the daily first if you care about the streak. It is one round per local date, and a
        reload continues it. Unlimited is the extra set: new prompts, same six tiers, same
        Spotlight, and a result grid you can share. It does not move the streak, and it does not
        wait for midnight.
      </p>
      <p class="mt-3 text-foreground">
        Category pages do the same thing inside one topic. Geography, animals, food, sports, movies
        and TV, music, science, and history each have a page.
      </p>
    </section>
    <RelatedLinks title="Keep playing" links={links} />
  </div>
</LocaleLayout>
