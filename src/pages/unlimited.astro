---
/**
 * Unlimited rounds. A new set every time, separate from the daily streak.
 * The game stays above the fold. Krillion unlimited is answered under it.
 */
import LocaleLayout from '~/components/layout/LocaleLayout.astro';
import GameApp from '~/components/game/GameApp.astro';
import GameFaq from '~/components/game/GameFaq.astro';
import RelatedLinks from '~/components/game/RelatedLinks.astro';
import LobbyHero from '~/components/home/LobbyHero.astro';
import LobbyContent from '~/components/home/LobbyContent.astro';
import CategoryDeck from '~/components/home/CategoryDeck.astro';
import TierLadder from '~/components/home/TierLadder.astro';
import HowToStrip from '~/components/home/HowToStrip.astro';
import BrowseAnswers from '~/components/home/BrowseAnswers.astro';
import { UNLIMITED } from '~/lib/game/copy';
import {
  CATEGORY_PAGE_LIST,
  LOBBY,
  COMPARE_LINKS,
  GUIDE_LINKS,
  UNLIMITED_COMPARE,
  UNLIMITED_TIPS,
  loadCatalog,
  measureCopy,
  unlimitedFaq,
} from '~/lib/game/category-copy';
import { site, siteUrl } from '~/config/site';
import { defaultLocale, locales } from '~/i18n/routing';
import { simpleBreadcrumbJsonLd, videoGameJsonLd } from '~/lib/seo';
import { languageAlternates, localizePath } from '~/lib/url';

const locale = defaultLocale;
const path = localizePath('/unlimited/', locale);
const alternates = languageAlternates((loc) => localizePath('/unlimited/', loc), locales);
const catalog = loadCatalog();
const rarityBody = measureCopy(
  catalog.map((entry) => entry.source),
  'No prompts are loaded, so this page has no view count to quote.',
);
const faq = unlimitedFaq();
const webApp: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Rarest Answer Unlimited',
  url: `${siteUrl}/unlimited/`,
  applicationCategory: 'GameApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  isAccessibleForFree: true,
  description: UNLIMITED.description,
  inLanguage: 'en',
};
const jsonLd: Record<string, unknown>[] = [
  videoGameJsonLd(),
  webApp,
  simpleBreadcrumbJsonLd({
    pageLabel: UNLIMITED.h1,
    path,
    locale,
    homeLabel: 'Home',
  }),
];
const links = [
  { href: '/', label: `Play today's ${site.game.name} daily` },
  ...CATEGORY_PAGE_LIST.map((page) => ({ href: `/trivia/${page.key}/`, label: page.h1 })),
  { href: '/games/games-like-krillion/', label: 'Games like Krillion' },
  { href: '/guides/how-to-find-rare-answers/', label: 'How to find rare answers' },
  { href: '/rarest-answers/', label: 'Browse the rarest answers' },
];
---

<LocaleLayout
  locale={locale}
  title={UNLIMITED.title}
  description={UNLIMITED.description}
  alternates={alternates}
  jsonLd={jsonLd}
  fullBleed
>
  <LobbyHero kicker={UNLIMITED.kicker} title={UNLIMITED.h1} lead={LOBBY.unlimitedLead}>
    <GameApp mode="unlimited">
      <a slot="end" class="btn-outline flex h-12 w-full items-center justify-center" href="/">
        Back to the daily
      </a>
    </GameApp>
  </LobbyHero>

  <LobbyContent>
    <CategoryDeck catalog={catalog} />
    <HowToStrip />
    <TierLadder />
    <BrowseAnswers />
    <div data-pagefind-body class="reading-grid">
      <section class="reading-card" id="what">
        <h2 class="text-2xl font-bold tracking-tight text-foreground">What unlimited play is</h2>
        <p class="mt-3 text-foreground">{UNLIMITED.intro}</p>
        <p class="mt-3 text-foreground">
          Category pages do the same thing inside one topic. Geography, animals, food, sports,
          movies and TV, music, science, and history each have a page.
        </p>
      </section>

      <section class="reading-card" id="rarity">
        <h2 class="text-2xl font-bold tracking-tight text-foreground">How rarity is measured</h2>
        <p class="mt-3 text-foreground">{rarityBody}</p>
      </section>

      <section class="reading-card" id="tips">
        <h2 class="text-2xl font-bold tracking-tight text-foreground">
          Tips before you spend the daily
        </h2>
        <p class="mt-3 text-foreground">{UNLIMITED_TIPS}</p>
        <ul class="mt-4 list-disc space-y-2 pl-5">
          {
            GUIDE_LINKS.map((link) => (
              <li>
                <a class="text-nav underline underline-offset-2" href={link.href}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="reading-card" id="compare">
        <h2 class="text-2xl font-bold tracking-tight text-foreground">
          Krillion unlimited is a different game
        </h2>
        <p class="mt-3 text-foreground">{UNLIMITED_COMPARE}</p>
        <ul class="mt-4 list-disc space-y-2 pl-5">
          {
            COMPARE_LINKS.map((link) => (
              <li>
                <a class="text-nav underline underline-offset-2" href={link.href}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
    <RelatedLinks title="Keep playing" links={links} />
    <GameFaq title="Unlimited round questions" items={faq} />
  </LobbyContent>
</LocaleLayout>
