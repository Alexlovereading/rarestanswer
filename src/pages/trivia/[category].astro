---
/**
 * One category, as many rounds as you want. Eight pages, one per CategoryKey.
 * The prompt list is whatever src/data/prompts/index.json contains for that
 * category: one row or a few hundred.
 */
import LocaleLayout from '~/components/layout/LocaleLayout.astro';
import GameApp from '~/components/game/GameApp.astro';
import GameFaq from '~/components/game/GameFaq.astro';
import RelatedLinks from '~/components/game/RelatedLinks.astro';
import LobbyHero from '~/components/home/LobbyHero.astro';
import LobbyContent from '~/components/home/LobbyContent.astro';
import CategoryDeck from '~/components/home/CategoryDeck.astro';
import TierLadder from '~/components/home/TierLadder.astro';
import CategoryPrompts from '~/components/home/CategoryPrompts.astro';
import BrowseAnswers from '~/components/home/BrowseAnswers.astro';
import HowToStrip from '~/components/home/HowToStrip.astro';
import SpotlightStrip from '~/components/home/SpotlightStrip.astro';
import NovaCta from '~/components/home/NovaCta.astro';
import {
  categoryCompare,
  categoryPage,
  categoryTips,
  CATEGORY_PAGE_LIST,
  COMPARE_LINKS,
  GUIDE_LINKS,
  loadCatalog,
  measureCopy,
  promptSectionTitle,
  promptsFor,
  type CatalogPrompt,
  type CategoryPageCopy,
} from '~/lib/game/category-copy';
import { defaultLocale, locales } from '~/i18n/routing';
import { simpleBreadcrumbJsonLd, urlListJsonLd, videoGameJsonLd } from '~/lib/seo';
import { absoluteUrl, languageAlternates, localizePath } from '~/lib/url';
import { siteUrl } from '~/config/site';

export function getStaticPaths() {
  const catalog = loadCatalog();
  return CATEGORY_PAGE_LIST.map((page) => ({
    params: { category: page.key },
    props: { page, prompts: promptsFor(catalog, page.key), catalog },
  }));
}

interface Props {
  page: CategoryPageCopy;
  prompts: CatalogPrompt[];
  catalog: CatalogPrompt[];
}

const { page, prompts, catalog } = Astro.props;
if (!page || !categoryPage(page.key)) {
  return Astro.redirect('/');
}

const locale = defaultLocale;
const path = localizePath(`/trivia/${page.key}/`, locale);
const alternates = languageAlternates((loc) => localizePath(`/trivia/${page.key}/`, loc), locales);
const rarityBody = measureCopy(
  prompts.map((prompt) => prompt.source),
  `No ${page.keyword} prompts are in the catalog, so this page has no view count to quote.`,
);
const jsonLd: Record<string, unknown>[] = [
  videoGameJsonLd({
    name: page.h1,
    description: page.intro,
    url: absoluteUrl(`/trivia/${page.key}/`, locale),
  }),
  simpleBreadcrumbJsonLd({
    pageLabel: page.h1,
    path,
    locale,
    homeLabel: 'Home',
  }),
];
if (prompts.length > 0) {
  jsonLd.push(
    urlListJsonLd({
      name: promptSectionTitle(page.keyword),
      items: prompts.map((prompt) => ({
        title: prompt.question,
        url: `${siteUrl}/answers/${encodeURIComponent(prompt.slug)}/`,
      })),
    }),
  );
}
const links = [
  { href: '/', label: "Play today's daily" },
  { href: '/unlimited/', label: 'Rarest Answer game unlimited' },
  ...CATEGORY_PAGE_LIST.filter((other) => other.key !== page.key).map((other) => ({
    href: `/trivia/${other.key}/`,
    label: other.h1,
  })),
  { href: '/rarest-answers/', label: 'Rarest answers' },
  { href: '/games/', label: 'Games like Krillion' },
  { href: '/guides/', label: 'Rarest Answer guides' },
  { href: '/guides/how-to-find-rare-answers/', label: 'How to find rare answers' },
];
---

<LocaleLayout
  locale={locale}
  title={page.title}
  description={page.description}
  alternates={alternates}
  jsonLd={jsonLd}
  fullBleed
>
  <LobbyHero
    kicker={page.keyword}
    title={page.h1}
    lead={page.lead}
    category={page.key}
    count={prompts.length}
  >
    <GameApp mode="category" category={page.key}>
      <a slot="end" class="btn-outline flex h-12 w-full items-center justify-center" href="/">
        Back to the daily
      </a>
      <a
        slot="end"
        class="btn-outline flex h-12 w-full items-center justify-center"
        href="/unlimited/"
      >
        Play unlimited
      </a>
    </GameApp>
  </LobbyHero>

  <LobbyContent>
    <HowToStrip />
    <TierLadder />
    <CategoryDeck catalog={catalog} />
    <SpotlightStrip catalog={catalog} />
    <CategoryPrompts page={page} prompts={prompts} />
    <div data-pagefind-body class="reading-grid">
      <section class="reading-card">
        <h2 class="text-2xl font-bold tracking-tight text-foreground">
          What {page.keyword} is here
        </h2>
        <p class="mt-3 text-foreground">{page.intro}</p>
      </section>

      <section class="reading-card" id="rarity">
        <h2 class="text-2xl font-bold tracking-tight text-foreground">How rarity is measured</h2>
        <p class="mt-3 text-foreground">{rarityBody}</p>
      </section>

      <section class="reading-card" id="tips">
        <h2 class="text-2xl font-bold tracking-tight text-foreground">Tips for this round</h2>
        <p class="mt-3 text-foreground">{categoryTips(page.h1)}</p>
        <ul class="mt-4 list-disc space-y-2 pl-5">
          {
            GUIDE_LINKS.map((link) => (
              <li>
                <a class="text-nav underline underline-offset-2" href={link.href}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="reading-card" id="compare">
        <h2 class="text-2xl font-bold tracking-tight text-foreground">Not a Krillion mode</h2>
        <p class="mt-3 text-foreground">{categoryCompare(page.h1)}</p>
        <ul class="mt-4 list-disc space-y-2 pl-5">
          {
            COMPARE_LINKS.map((link) => (
              <li>
                <a class="text-nav underline underline-offset-2" href={link.href}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
    <BrowseAnswers />
    <RelatedLinks title="Other rounds" links={links} />
    <GameFaq title={`${page.h1} questions`} items={page.faq} />
    <NovaCta />
  </LobbyContent>
</LocaleLayout>
