---
/**
 * Daily play page. The English homepage is the game. RootGateway stays on
 * disk for the fork survive pin, and this page does not render it.
 * The game stays above the fold. Search copy sits under it.
 */
import LocaleLayout from '~/components/layout/LocaleLayout.astro';
import GameApp from '~/components/game/GameApp.astro';
import GameFaq from '~/components/game/GameFaq.astro';
import RelatedLinks from '~/components/game/RelatedLinks.astro';
import TierTable from '~/components/game/TierTable.astro';
import { HOME, HOME_FAQ, HOW_TO_STEPS } from '~/lib/game/copy';
import {
  CATEGORY_PAGE_LIST,
  COMPARE_LINKS,
  GUIDE_LINKS,
  HOME_COMPARE,
  HOME_TIPS,
  HOME_WHAT,
  loadCatalog,
  measureCopy,
  tierSentence,
} from '~/lib/game/category-copy';
import { site, siteUrl } from '~/config/site';
import { defaultLocale, locales } from '~/i18n/routing';
import { faqPageJsonLd, videoGameJsonLd, websiteJsonLd } from '~/lib/seo';
import { homeUrl, languageAlternates } from '~/lib/url';

const locale = defaultLocale;
const alternates = languageAlternates((loc) => homeUrl(loc), locales);
const catalog = loadCatalog();
const rarityBody = measureCopy(
  catalog.map((entry) => entry.source),
  'No prompts are loaded, so this page has no view count to quote.',
);
const faq = HOME_FAQ.map((item) =>
  item.question.toLowerCase().includes('how is rarity')
    ? { question: item.question, answer: `${rarityBody} ${tierSentence()}` }
    : item,
);
const webApp: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: site.game.name,
  url: `${siteUrl}/`,
  applicationCategory: 'GameApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  isAccessibleForFree: true,
  description: HOME.description,
  inLanguage: 'en',
};
const jsonLd: Record<string, unknown>[] = [
  websiteJsonLd(locale),
  videoGameJsonLd(),
  webApp,
  faqPageJsonLd([...faq]),
];
const links = [
  { href: '/unlimited/', label: 'Rarest Answer game unlimited' },
  ...CATEGORY_PAGE_LIST.map((page) => ({ href: `/trivia/${page.key}/`, label: page.h1 })),
  { href: '/rarest-answers/', label: 'Rarest answers, prompt by prompt' },
  { href: '/games/games-like-krillion/', label: 'Games like Krillion' },
  { href: '/guides/how-to-find-rare-answers/', label: 'How to find rare answers' },
];
---

<LocaleLayout
  locale={locale}
  title={HOME.title}
  description={HOME.description}
  alternates={alternates}
  jsonLd={jsonLd}
  fullBleed
>
  <div data-pagefind-body>
    <header class="mx-auto max-w-3xl px-4 pt-6 sm:pt-10">
      <p class="text-sm font-semibold text-nav">{HOME.kicker}</p>
      <h1 class="mt-2 text-balance text-3xl font-black tracking-tight text-foreground sm:text-4xl">
        {HOME.h1}
      </h1>
    </header>
  </div>

  <div class="mx-auto mt-6 max-w-3xl px-4">
    <GameApp mode="daily">
      <a
        slot="end"
        class="btn-primary flex h-12 w-full items-center justify-center"
        href="/unlimited/"
      >
        Play unlimited
      </a>
      <a slot="end" class="btn-outline flex h-12 w-full items-center justify-center" href="#ways">
        Pick a category
      </a>
    </GameApp>
  </div>

  <div data-pagefind-body class="mx-auto mt-16 max-w-3xl px-4 pb-16">
    <section id="what">
      <h2 class="text-2xl font-bold tracking-tight text-foreground">
        What is the Rarest Answer game?
      </h2>
      <p class="mt-3 text-foreground">{HOME.intro}</p>
      {HOME_WHAT.map((paragraph) => <p class="mt-3 text-foreground">{paragraph}</p>)}
      <p class="mt-3 text-foreground">
        The full rules are on
        <a class="text-nav underline underline-offset-2" href="/guides/how-to-play-rarest-answer/">
          how to play the Rarest Answer game
        </a>. A daily round works like this.
      </p>
      <ol class="mt-4 list-decimal space-y-3 pl-5 text-foreground">
        {HOW_TO_STEPS.map((step) => <li>{step}</li>)}
      </ol>
    </section>

    <section class="mt-16" id="rarity">
      <h2 class="text-2xl font-bold tracking-tight text-foreground">How rarity is measured</h2>
      <p class="mt-3 text-foreground">{rarityBody}</p>
      <p class="mt-3 text-foreground">
        Each published prompt has its ranking on
        <a class="text-nav underline underline-offset-2" href="/rarest-answers/">rarest answers</a>.
      </p>
    </section>

    <section class="mt-16" id="tiers">
      <h2 class="text-2xl font-bold tracking-tight text-foreground">Scoring tiers</h2>
      <div class="mt-4">
        <TierTable />
      </div>
    </section>

    <section class="mt-16" id="tips">
      <h2 class="text-2xl font-bold tracking-tight text-foreground">Tips for finding rare answers</h2>
      <p class="mt-3 text-foreground">{HOME_TIPS}</p>
      <ul class="mt-4 list-disc space-y-2 pl-5">
        {
          GUIDE_LINKS.map((link) => (
            <li>
              <a class="text-nav underline underline-offset-2" href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-16" id="compare">
      <h2 class="text-2xl font-bold tracking-tight text-foreground">Rarest Answer and Krillion</h2>
      <p class="mt-3 text-foreground">{HOME_COMPARE}</p>
      <ul class="mt-4 list-disc space-y-2 pl-5">
        {
          COMPARE_LINKS.map((link) => (
            <li>
              <a class="text-nav underline underline-offset-2" href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <RelatedLinks id="ways" title="More ways to play" links={links} />
    <GameFaq title="Rarest Answer questions" items={faq} />
  </div>
</LocaleLayout>
