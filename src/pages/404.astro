---
/**
 * Global 404. Uses the site shell so a lost visit can still reach play,
 * search, and the two reading sections. Search opens the header dialog
 * (data-open-search) instead of mounting a second SearchButton.
 */
import { Icon } from 'astro-icon/components';
import LocaleLayout from '~/components/layout/LocaleLayout.astro';
import PlayCta from '~/components/article/PlayCta.astro';
import HeroArt from '~/components/art/HeroArt.astro';
import TierBadge from '~/components/art/TierBadge.astro';
import { NAVIGATION_CONFIG } from '~/config/navigation';
import { defaultLocale } from '~/i18n/routing';
import { getUi } from '~/i18n/ui';
import { homeUrl, listPath, localizePath } from '~/lib/url';

const locale = defaultLocale;
const ui = getUi(locale);
const nav = ui.nav;
const shared = ui.shared;

const recover = [
  { href: homeUrl(locale), label: nav.play, icon: 'lucide:play' },
  { href: localizePath('/unlimited/', locale), label: nav.unlimited, icon: 'lucide:infinity' },
  { href: localizePath('/rarest-answers/', locale), label: nav.rarestAnswers, icon: 'lucide:gem' },
  ...NAVIGATION_CONFIG.map((item) => ({
    href: listPath(item.key, locale),
    label: nav[item.key as keyof typeof nav] ?? item.key,
    icon: item.icon,
  })),
];
---

<LocaleLayout
  locale={locale}
  title={shared.notFoundTitle}
  description={shared.notFoundDescription}
  noindex={true}
>
  <div class="mx-auto max-w-xl py-10 text-center sm:py-16">
    <div class="rare-page-art">
      <HeroArt />
      <div class="rare-page-art__badge"><TierBadge tier={6} size={64} /></div>
    </div>
    <p class="font-display text-7xl font-extrabold tracking-tight text-nav md:text-8xl">404</p>
    <h1 class="mt-4 font-display text-3xl font-semibold tracking-tight">{shared.visuals.rarePage}</h1>
    <p class="mt-2 text-muted-foreground">{shared.visuals.rarePageNote}</p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a href={homeUrl(locale)} class="btn-primary gap-2 px-5 py-2.5">
        <Icon name="lucide:play" class="h-4 w-4" aria-hidden="true" />
        {shared.notFoundBackHome}
      </a>
      <button type="button" data-open-search class="btn-outline min-h-11 gap-2 px-4">
        <Icon name="lucide:search" class="h-4 w-4" aria-hidden="true" />
        {nav.search}
      </button>
    </div>
    <p class="mt-3 text-xs text-muted-foreground">{shared.notFoundSearchHint}</p>

    <div class="mt-12 text-left">
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-nav">{shared.notFoundPopular}</p>
      <ul class="mt-3 grid list-none gap-2 p-0 sm:grid-cols-2">
        {
          recover.map((item) => (
            <li>
              <a href={item.href} class="card flex min-h-11 items-center gap-2 px-4 py-3 text-sm font-medium">
                <Icon name={item.icon} class="h-4 w-4 shrink-0 text-nav" aria-hidden="true" />
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-8 text-left">
      <PlayCta locale={locale} />
    </div>
  </div>
</LocaleLayout>
