---
import CategoryArt from '~/components/art/CategoryArt.astro';
import type { CategoryKey } from '~/lib/game/types';
import { NOVA_ALT } from '~/lib/game/copy';

interface Props {
  category?: CategoryKey;
  compact?: boolean;
  decorative?: boolean;
  lazy?: boolean;
}
const { category, compact = false, decorative = false, lazy = false } = Astro.props;
---

<div class:list={['world-art', compact && 'world-art--compact']}>
  {category ? <CategoryArt category={category} size={compact ? 80 : 160} decorative={decorative} /> : (
    <img
      src="/images/world/nova-waving-160x160.webp"
      srcset="/images/world/nova-waving-160x160.webp 160w, /images/world/nova-waving-320x320.webp 320w"
      sizes={compact ? '80px' : '160px'}
      width="160"
      height="160"
      alt={decorative ? '' : NOVA_ALT.waving}
      aria-hidden={decorative ? 'true' : undefined}
      loading={lazy ? 'lazy' : 'eager'}
      decoding="async"
    />
  )}
</div>
