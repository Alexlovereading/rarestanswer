---
/**
 * Invitation to the daily game. Copy is home.closingCta (one source for
 * the seven-prompt / local-date claim). The box is a tint, not a solid
 * brand fill, so body text stays on --foreground.
 */
import { Icon } from 'astro-icon/components';
import TierBadge from '~/components/art/TierBadge.astro';
import { type Locale } from '~/i18n/routing';
import { getUi } from '~/i18n/ui';
import { homeUrl } from '~/lib/url';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const cta = getUi(locale).home.closingCta;
---

<aside class="play-cta" aria-label={cta.title}>
  <div class="play-cta__art" aria-hidden="true"><TierBadge tier={6} size={80} /></div>
  <div class="min-w-0 flex-1">
    <p class="flex items-center gap-2 font-display text-xl font-semibold tracking-tight text-foreground">
      {cta.title}
    </p>
    <p class="mt-1 max-w-xl text-sm leading-relaxed text-muted-foreground">{cta.description}</p>
  </div>
  <a href={homeUrl(locale)} class="btn-primary gap-2 px-5 py-2.5">
    {cta.primary}
    <Icon name="lucide:arrow-right" class="h-4 w-4" aria-hidden="true" />
  </a>
</aside>
