---
/**
 * Recent-updates page — all articles in a locale, newest first.
 * High-intent entry point ("x patch notes", "update wiki" queries);
 * pairs with sitemap lastmod for crawl-freshness signals.
 */
import { Icon } from 'astro-icon/components';
import LocaleLayout from '~/components/layout/LocaleLayout.astro';
import ArticleCard from '~/components/article/ArticleCard.astro';
import { type Locale } from '~/i18n/routing';
import { getUi } from '~/i18n/ui';
import { getRecentEntries, parseEntryId } from '~/lib/content';
import { pageTitle, simpleBreadcrumbJsonLd, urlListJsonLd } from '~/lib/seo';
import { detailPath, homeUrl, recentPath } from '~/lib/url';
import { siteUrl } from '~/config/site';

interface Props {
  locale: Locale;
  alternates?: Array<{ hreflang: string; href: string }>;
  /**
   * Zero published articles in this locale = thin empty state — noindex,
   * same treatment as ListPage's empty category lists (page files compute
   * the empty state per locale and pass it in).
   */
  noindex?: boolean;
}
const { locale, alternates = [], noindex = false } = Astro.props;
const ui = getUi(locale);
const nav = ui.nav;
const navLabels = nav as Record<string, string>;
const shared = ui.shared;

const title = shared.recentTitle;
const description = shared.recentDescription;

const entries = await getRecentEntries(locale, 200);

const jsonLd = [
  urlListJsonLd({
    name: title,
    items: entries.map((e) => {
      const parsed = parseEntryId(e.id);
      return {
        title: e.data.title,
        url: `${siteUrl}${detailPath(parsed?.category ?? '', parsed?.slug ?? '', locale)}`,
      };
    }),
  }),
  simpleBreadcrumbJsonLd({ pageLabel: title, path: recentPath(locale), locale, homeLabel: nav.home }),
];
---

<LocaleLayout
  locale={locale}
  title={pageTitle(title)}
  description={description}
  alternates={alternates}
  jsonLd={jsonLd}
  noindex={noindex}
>
  <div class="space-y-6">
    <header>
      <nav class="flex flex-wrap items-center gap-1 text-sm text-muted-foreground" aria-label={shared.breadcrumbAria ?? 'Breadcrumb'}>
        <a href={homeUrl(locale)} class="hover:text-nav">{nav.home}</a>
        <Icon name="lucide:chevron-right" class="h-3.5 w-3.5" aria-hidden="true" />
        <span class="text-foreground">{title}</span>
      </nav>
      <div class="mt-4 flex items-center gap-2 text-nav">
        <Icon name="lucide:history" class="h-4 w-4" aria-hidden="true" />
        <p class="text-xs font-semibold uppercase tracking-[0.14em]">{title}</p>
      </div>
      <h1 class="mt-2 font-display text-4xl font-extrabold tracking-tight text-balance md:text-5xl">{title}</h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted-foreground">{description}</p>
    </header>

    {
      entries.length === 0 ? (
        <div class="empty-panel p-12 text-center">
          <Icon name="lucide:inbox" class="mx-auto h-10 w-10 text-muted-foreground" />
          <p class="mt-3 text-muted-foreground">{shared.noArticles}</p>
        </div>
      ) : (
        <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
          {entries.map((entry) => {
            const parsed = parseEntryId(entry.id);
            const category = parsed?.category ?? '';
            const meta = entry.data.lastModified
              ? `${shared.lastUpdated}: ${entry.data.lastModified.toLocaleDateString(locale, { timeZone: 'UTC' })}`
              : `${shared.publishedOn}: ${entry.data.date.toLocaleDateString(locale, { timeZone: 'UTC' })}`;
            return (
              <ArticleCard
                href={detailPath(category, parsed?.slug ?? '', locale)}
                title={entry.data.title}
                description={entry.data.description}
                meta={meta}
                categoryLabel={navLabels[category] ?? category}
                image={entry.data.image}
              />
            );
          })}
        </div>
      )
    }
  </div>
</LocaleLayout>
