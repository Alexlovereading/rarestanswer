---
/**
 * Cover-led article card for list, recent, and tag grids.
 * The 16:9 frame is reserved even when a cover is missing, so the grid
 * does not jump. The cover is decorative: the title is the link name.
 */
import type { ImageMetadata } from 'astro';
import { Icon } from 'astro-icon/components';
import ArticleCover from './ArticleCover.astro';
import ArticleCardMeta from './ArticleCardMeta.astro';
import WorldArt from './WorldArt.astro';
import { articleArtCategory } from './article-art';

interface Props {
  href: string;
  title: string;
  description: string;
  meta: string;
  readTime?: string;
  date?: Date;
  categoryLabel?: string;
  image?: ImageMetadata;
  sizes?: string;
  /** Card title level. List grids under an "All pages" h2 use h3. */
  heading?: 'h2' | 'h3';
}
const {
  href,
  title,
  description,
  meta,
  readTime,
  date,
  categoryLabel,
  image,
  sizes,
  heading = 'h2',
} = Astro.props;
const Title = heading;
---

<a href={href} class="article-card">
  <div class="article-card__media">
    {
      image ? (
        <ArticleCover
          src={image}
          alt=""
          sizes={sizes}
          height={Math.round(800 * image.height / image.width)}
          class="article-card__image"
        />
      ) : <WorldArt category={articleArtCategory(title)} compact decorative lazy />
    }
  </div>
  <div class="article-card__content">
    {
      categoryLabel && (
        <p class="article-card__category">{categoryLabel}</p>
      )
    }
    <Title class="article-card__title">
      {title}
    </Title>
    <p class="article-card__description">{description}</p>
    <div class="article-card__footer">
      <ArticleCardMeta meta={meta} readTime={readTime} date={date} />
      <Icon name="lucide:arrow-up-right" class="article-card__arrow" aria-hidden="true" />
    </div>
  </div>
</a>

<style>
  .article-card {
    display: flex;
    height: 100%;
    min-width: 0;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid hsl(var(--border));
    border-radius: calc(var(--radius) + 0.25rem);
    background: hsl(var(--card));
    color: hsl(var(--foreground));
    box-shadow: 0 6px 20px -16px hsl(var(--brand) / 0.25);
  }

  .article-card__media {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    flex-shrink: 0;
    border-bottom: 1px solid hsl(var(--border));
    background: hsl(var(--muted));
  }

  .article-card__media :global(.article-card__image) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }

  .article-card__content {
    display: flex;
    min-width: 0;
    flex: 1;
    flex-direction: column;
    gap: 0.625rem;
    padding: 1.25rem;
  }

  .article-card__category {
    color: hsl(var(--brand-text));
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .article-card__title {
    min-height: 2.7em;
    font-size: 1.1875rem;
    font-weight: 600;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .article-card__description {
    overflow: hidden;
    color: hsl(var(--muted-foreground));
    font-size: 0.9375rem;
    line-height: 1.5;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .article-card__footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: auto;
    border-top: 1px solid hsl(var(--border));
    padding-top: 0.875rem;
  }

  .article-card__footer :global(.article-card__arrow) {
    width: 1.125rem;
    height: 1.125rem;
    flex-shrink: 0;
    color: hsl(var(--brand-text));
  }

  .article-card:focus-visible {
    outline: 3px solid hsl(var(--brand-text));
    outline-offset: 4px;
    border-color: hsl(var(--brand));
  }

  @media (prefers-reduced-motion: no-preference) {
    .article-card {
      transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
    }
  }

  @media (hover: hover) {
    .article-card:hover {
      border-color: hsl(var(--brand) / 0.45);
      box-shadow: 0 14px 32px -20px hsl(var(--brand) / 0.3);
    }

    .article-card:hover .article-card__title {
      color: hsl(var(--brand-text));
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .article-card:hover {
      transform: translateY(-3px);
    }
  }
</style>
