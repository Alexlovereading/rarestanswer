---
/**
 * BackToTop — floating "scroll to top" button.
 *
 * Long boss guides get scrolled a lot on mobile; getting back to the TOC /
 * header by thumb-flicking is painful. Appears after 600px of scroll, hides
 * near the top. ~15 lines vanilla JS, passive scroll listener.
 *
 * aria-label is shared.backToTop. The English fallback only runs when the
 * page locale has no wiki JSON.
 */
import { Icon } from 'astro-icon/components';
import { currentSharedStrings } from '~/lib/shared-ui';

const shared = currentSharedStrings(Astro.currentLocale);
const label = shared.backToTop ?? 'Back to top';
---

<button
  type="button"
  id="back-to-top"
  hidden
  aria-label={label}
  class="fixed bottom-5 right-5 z-40 inline-flex h-10 w-10 items-center justify-center rounded-full border border-border bg-card text-muted-foreground shadow-md transition hover:border-nav/50 hover:text-nav"
>
  <Icon name="lucide:arrow-up" class="h-5 w-5" />
</button>

<script>
  (() => {
    const btn = document.getElementById('back-to-top');
    if (!btn) return;
    let visible = false;
    const onScroll = () => {
      const shouldShow = window.scrollY > 600;
      if (shouldShow !== visible) {
        visible = shouldShow;
        btn.hidden = !shouldShow;
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
    btn.addEventListener('click', () => {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
    });
  })();
</script>
