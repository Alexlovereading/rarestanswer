---
/**
 * List page — shows all articles in a category for a locale.
 *
 * Behavior (PRD §9.3): does NOT fall back to English. If the locale has
 * no articles in this category, the empty state is shown.
 */
import { Icon } from 'astro-icon/components';
import LocaleLayout from '~/components/layout/LocaleLayout.astro';
import ArticleCard from '~/components/article/ArticleCard.astro';
import ArticleCover from '~/components/article/ArticleCover.astro';
import DealsOverview from '~/components/article/DealsOverview.astro';
import PlayCta from '~/components/article/PlayCta.astro';
import { NAVIGATION_CONFIG } from '~/config/navigation';
import { site } from '~/config/site';
import { type Locale } from '~/i18n/routing';
import { getUi } from '~/i18n/ui';
import { getEntriesByCategory, parseEntryId } from '~/lib/content';
import { toDealMerchants } from '~/lib/content-utils';
import { itemListJsonLd, pageTitle, simpleBreadcrumbJsonLd } from '~/lib/seo';
import { CATEGORY_PAGES } from '~/lib/game/category-copy';
import { detailPath, homeUrl, listPath, localizePath } from '~/lib/url';

interface Props {
  locale: Locale;
  category: string;
  /** hreflang alternates (built by the route page). */
  alternates?: Array<{ hreflang: string; href: string }>;
}
const { locale, category, alternates = [] } = Astro.props;
const ui = getUi(locale);
const nav = ui.nav as Record<string, string>;
const shared = ui.shared;
const overview = (
  ui.overview as Record<string, { overviewTitle: string; overviewDescription: string }>
)[category];
const navItem = NAVIGATION_CONFIG.find((n) => n.key === category);

const title = overview?.overviewTitle ?? nav[category] ?? category;
// Localized default (locale JSON shared.defaultListDescription) — a hardcoded
// English sentence here would leak into every locale the moment a fork adds
// a 5th category without an overview entry. `|| title` (not ??) so an empty
// locale string genuinely falls back to the bare title.
const description =
  overview?.overviewDescription ??
  (String(shared.defaultListDescription ?? '').replace('{title}', title) || title);

const entries = await getEntriesByCategory(category, locale);

// Coupon-hub presentation variant: the codes list becomes a merchant-grouped
// deals board instead of article cards. Build-time signal from site.ts —
// game-wiki forks never carry the line, so this branch is dead code there.
const dealView = site.siteType === 'coupon-hub' && category === 'codes' && entries.length > 0;
const merchants = toDealMerchants(entries).map((m) => ({
  title: m.title,
  href: detailPath(category, m.slug, locale),
  codes: m.codes,
}));

const exploreLinks =
  category === 'games' || category === 'guides'
    ? [
        { href: homeUrl(locale), label: nav.play ?? 'Play' },
        { href: localizePath('/unlimited/', locale), label: nav.unlimited ?? 'Unlimited' },
        {
          href: localizePath('/rarest-answers/', locale),
          label: nav.rarestAnswers ?? 'Rarest Answers',
        },
        { href: localizePath('/trivia/animals/', locale), label: CATEGORY_PAGES.animals.h1 },
        { href: localizePath('/games/', locale), label: nav.games ?? 'Games' },
        { href: localizePath('/guides/', locale), label: nav.guides ?? 'Guides' },
      ].filter((link) => link.href.replace(/\/$/, '') !== listPath(category, locale).replace(/\/$/, ''))
    : [];

// Pillar pages named in the site plan. If that slug is absent, the newest
// remaining entry still leads the grid so the layout does not collapse.
const PILLAR_SLUGS: Record<string, string> = {
  games: 'games-like-krillion',
  guides: 'how-to-find-rare-answers',
};
const featured =
  entries.find((entry) => parseEntryId(entry.id)?.slug === PILLAR_SLUGS[category]) ??
  entries[0] ??
  null;
const rest = featured ? entries.filter((entry) => entry !== featured) : entries;
const pageCountLabel = shared.pageCount.replace('{count}', String(entries.length));

const stamp = (entry: (typeof entries)[number]) =>
  entry.data.lastModified
    ? `${shared.lastUpdated}: ${entry.data.lastModified.toLocaleDateString(locale, { timeZone: 'UTC' })}`
    : `${shared.publishedOn}: ${entry.data.date.toLocaleDateString(locale, { timeZone: 'UTC' })}`;

const jsonLd = [
  // Empty ItemList (itemListElement: []) is invalid structured data — only
  // inject when the list actually has entries (breadcrumb stays either way).
  ...(entries.length > 0
    ? [
        itemListJsonLd({
          category,
          categoryLabel: title,
          locale,
          items: entries.map((e) => {
            const slug = parseEntryId(e.id)?.slug ?? '';
            return { title: e.data.title, slug };
          }),
        }),
      ]
    : []),
  simpleBreadcrumbJsonLd({
    pageLabel: title,
    path: listPath(category, locale),
    locale,
    homeLabel: nav.home,
  }),
];
---

<!-- An empty list is a ~100-word thin-content page (NMS /starships was indexed
     as one). noindex keeps it out of Google until real articles exist; the
     sitemap filter excludes the same paths (astro.config.ts). -->
<LocaleLayout
  locale={locale}
  title={pageTitle(title)}
  description={description}
  alternates={alternates}
  jsonLd={jsonLd}
  noindex={entries.length === 0}
>
  <div class="space-y-8">
    <header class="max-w-3xl">
      <nav class="flex flex-wrap items-center gap-1 text-sm text-muted-foreground" aria-label={shared.breadcrumbAria ?? 'Breadcrumb'}>
        <a href={homeUrl(locale)} class="hover:text-nav">{nav.home}</a>
        <Icon name="lucide:chevron-right" class="h-3.5 w-3.5" aria-hidden="true" />
        <span class="text-foreground">{nav[category] ?? title}</span>
      </nav>
      <div class="mt-4 flex items-center gap-2 text-nav">
        {navItem && <Icon name={navItem.icon} class="h-4 w-4 shrink-0" aria-hidden="true" />}
        <p class="text-xs font-semibold uppercase tracking-[0.14em]">{nav[category] ?? category}</p>
      </div>
      <h1 class="mt-2 font-display text-4xl font-extrabold tracking-tight text-balance md:text-5xl">{title}</h1>
      <p class="mt-4 text-lg leading-relaxed text-muted-foreground">{description}</p>
      {entries.length > 0 && <p class="mt-3 text-sm text-muted-foreground">{pageCountLabel}</p>}
    </header>

    {
      entries.length === 0 ? (
        <div class="empty-panel p-12 text-center">
          <Icon name="lucide:inbox" class="mx-auto h-10 w-10 text-muted-foreground" />
          <p class="mt-3 text-muted-foreground">{shared.noArticles}</p>
        </div>
      ) : dealView ? (
        <DealsOverview
          merchants={merchants}
          labels={shared.codesTable ?? {}}
          copiedText={shared.copied}
        />
      ) : (
        <div class="space-y-8">
          {featured && (
            <a
              href={detailPath(category, parseEntryId(featured.id)?.slug ?? '', locale)}
              class="card group grid overflow-hidden p-0 md:grid-cols-2"
            >
              <div class="relative aspect-video overflow-hidden bg-muted md:aspect-auto md:h-full md:min-h-[16rem]">
                {featured.data.image && (
                  <ArticleCover
                    src={featured.data.image}
                    alt=""
                    loading="eager"
                    sizes="(max-width: 768px) 100vw, 40rem"
                    widths={[400, 800, 1200]}
                    class="mb-0 h-full w-full rounded-none object-cover md:absolute md:inset-0"
                  />
                )}
              </div>
              <div class="flex flex-col justify-center p-5 sm:p-8">
                <p class="text-xs font-semibold uppercase tracking-[0.14em] text-nav">{shared.featuredLabel}</p>
                <h2 class="mt-2 font-display text-2xl font-semibold leading-snug tracking-tight md:text-3xl">
                  {featured.data.title}
                </h2>
                <p class="mt-3 text-base leading-relaxed text-muted-foreground">{featured.data.description}</p>
                <p class="mt-4 text-xs text-muted-foreground">{stamp(featured)}</p>
                <p class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-nav">
                  {shared.readThis}
                  <Icon name="lucide:arrow-right" class="h-4 w-4" aria-hidden="true" />
                </p>
              </div>
            </a>
          )}
          {rest.length > 0 && (
            <div>
              <h2 class="font-display text-2xl font-semibold tracking-tight">{shared.allPages}</h2>
              <div class="mt-4 grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
                {rest.map((entry) => {
                  const slug = parseEntryId(entry.id)?.slug ?? '';
                  return (
                    <ArticleCard
                      href={detailPath(category, slug, locale)}
                      title={entry.data.title}
                      description={entry.data.description}
                      meta={stamp(entry)}
                      image={entry.data.image}
                      heading="h3"
                    />
                  );
                })}
              </div>
            </div>
          )}
        </div>
      )
    }
    {
      exploreLinks.length > 0 && (
        <nav aria-label={shared.keepExploring}>
          <h2 class="text-xl font-bold tracking-tight">{shared.keepExploring}</h2>
          <ul class="mt-3 flex list-none flex-wrap gap-2 p-0">
            {exploreLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="inline-flex min-h-11 items-center rounded-full border border-border bg-card px-4 text-sm font-medium text-nav hover:border-nav"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
    {entries.length > 0 && <PlayCta locale={locale} />}
  </div>
</LocaleLayout>
