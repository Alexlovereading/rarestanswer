---
/**
 * List page — shows all articles in a category for a locale.
 *
 * Behavior (PRD §9.3): does NOT fall back to English. If the locale has
 * no articles in this category, the empty state is shown.
 */
import { Icon } from 'astro-icon/components';
import LocaleLayout from '~/components/layout/LocaleLayout.astro';
import ArticleCard from '~/components/article/ArticleCard.astro';
import ArticleCover from '~/components/article/ArticleCover.astro';
import ArticleCardMeta from '~/components/article/ArticleCardMeta.astro';
import DealsOverview from '~/components/article/DealsOverview.astro';
import PlayCta from '~/components/article/PlayCta.astro';
import WorldArt from '~/components/article/WorldArt.astro';
import { NAVIGATION_CONFIG } from '~/config/navigation';
import { site } from '~/config/site';
import { type Locale } from '~/i18n/routing';
import { getUi } from '~/i18n/ui';
import { estimateReadMinutes, getEntriesByCategory, parseEntryId } from '~/lib/content';
import { toDealMerchants } from '~/lib/content-utils';
import { itemListJsonLd, simpleBreadcrumbJsonLd, withArticleCount } from '~/lib/seo';
import { CATEGORY_PAGES } from '~/lib/game/category-copy';
import { detailPath, homeUrl, listPath, localizePath } from '~/lib/url';

interface Props {
  locale: Locale;
  category: string;
  /** hreflang alternates (built by the route page). */
  alternates?: Array<{ hreflang: string; href: string }>;
}
const { locale, category, alternates = [] } = Astro.props;
const ui = getUi(locale);
const nav = ui.nav as Record<string, string>;
const shared = ui.shared;
const overview = (
  ui.overview as Record<string, { overviewTitle: string; overviewDescription: string }>
)[category];
const navItem = NAVIGATION_CONFIG.find((n) => n.key === category);

const entries = await getEntriesByCategory(category, locale);
const articleCount = entries.length;
// `{count}` stays in the locale strings until here, so the number is the
// articles on this page rather than a figure written into JSON.
const title = withArticleCount(overview?.overviewTitle ?? nav[category] ?? category, articleCount);
// Localized default (locale JSON shared.defaultListDescription) — a hardcoded
// English sentence here would leak into every locale the moment a fork adds
// a 5th category without an overview entry. `|| title` (not ??) so an empty
// locale string genuinely falls back to the bare title.
const description = withArticleCount(
  overview?.overviewDescription ??
    (String(shared.defaultListDescription ?? '').replace('{title}', title) || title),
  articleCount,
);

// Coupon-hub presentation variant: the codes list becomes a merchant-grouped
// deals board instead of article cards. Build-time signal from site.ts —
// game-wiki forks never carry the line, so this branch is dead code there.
const dealView = site.siteType === 'coupon-hub' && category === 'codes' && entries.length > 0;
const merchants = toDealMerchants(entries).map((m) => ({
  title: m.title,
  href: detailPath(category, m.slug, locale),
  codes: m.codes,
}));

const exploreLinks =
  category === 'games' || category === 'guides'
    ? [
        { href: homeUrl(locale), label: nav.play ?? 'Play' },
        { href: localizePath('/unlimited/', locale), label: nav.unlimited ?? 'Unlimited' },
        {
          href: localizePath('/rarest-answers/', locale),
          label: nav.rarestAnswers ?? 'Rarest Answers',
        },
        { href: localizePath('/trivia/animals/', locale), label: CATEGORY_PAGES.animals.h1 },
        { href: localizePath('/games/', locale), label: nav.games ?? 'Games' },
        { href: localizePath('/guides/', locale), label: nav.guides ?? 'Guides' },
      ].filter((link) => link.href.replace(/\/$/, '') !== listPath(category, locale).replace(/\/$/, ''))
    : [];

// Pillar pages named in the site plan. If that slug is absent, the newest
// remaining entry still leads the grid so the layout does not collapse.
const PILLAR_SLUGS: Record<string, string> = {
  games: 'games-like-krillion',
  guides: 'how-to-find-rare-answers',
};
const featured =
  entries.find((entry) => parseEntryId(entry.id)?.slug === PILLAR_SLUGS[category]) ??
  entries[0] ??
  null;
const rest = featured ? entries.filter((entry) => entry !== featured) : entries;
const pageCountLabel = shared.pageCount.replace('{count}', String(entries.length));
const readTime = (entry: (typeof entries)[number]) =>
  `${estimateReadMinutes(entry.body ?? '', locale)} ${shared.minuteRead}`;

const stamp = (entry: (typeof entries)[number]) =>
  entry.data.lastModified
    ? `${shared.lastUpdated}: ${entry.data.lastModified.toLocaleDateString(locale, { timeZone: 'UTC' })}`
    : `${shared.publishedOn}: ${entry.data.date.toLocaleDateString(locale, { timeZone: 'UTC' })}`;

const jsonLd = [
  // Empty ItemList (itemListElement: []) is invalid structured data — only
  // inject when the list actually has entries (breadcrumb stays either way).
  ...(entries.length > 0
    ? [
        itemListJsonLd({
          category,
          categoryLabel: title,
          locale,
          items: entries.map((e) => {
            const slug = parseEntryId(e.id)?.slug ?? '';
            return { title: e.data.title, slug };
          }),
        }),
      ]
    : []),
  simpleBreadcrumbJsonLd({
    pageLabel: title,
    path: listPath(category, locale),
    locale,
    homeLabel: nav.home,
  }),
];
---

<!-- An empty list is a ~100-word thin-content page (NMS /starships was indexed
     as one). noindex keeps it out of Google until real articles exist; the
     sitemap filter excludes the same paths (astro.config.ts). -->
<LocaleLayout
  locale={locale}
  title={title}
  description={description}
  alternates={alternates}
  jsonLd={jsonLd}
  noindex={entries.length === 0}
>
  <div class="space-y-8">
    <header class="content-band content-band--wide">
      <div class="min-w-0">
      <nav class="flex flex-wrap items-center gap-1 text-sm text-muted-foreground" aria-label={shared.breadcrumbAria ?? 'Breadcrumb'}>
        <a href={homeUrl(locale)} class="hover:text-nav">{nav.home}</a>
        <Icon name="lucide:chevron-right" class="h-3.5 w-3.5" aria-hidden="true" />
        <span class="text-foreground">{nav[category] ?? title}</span>
      </nav>
      <div class="mt-4 flex items-center gap-2 text-nav">
        {navItem && <Icon name={navItem.icon} class="h-4 w-4 shrink-0" aria-hidden="true" />}
        <p class="text-xs font-semibold uppercase tracking-[0.14em]">{nav[category] ?? category}</p>
      </div>
      <h1 class="mt-2 font-display text-4xl font-extrabold tracking-tight text-balance md:text-5xl">{title}</h1>
      <p class="mt-4 text-lg leading-relaxed text-muted-foreground">{description}</p>
      {entries.length > 0 && <p class="content-band__count mt-4">{pageCountLabel}</p>}
      </div>
      <div class="content-band__art"><WorldArt /></div>
    </header>

    {
      entries.length === 0 ? (
        <div class="empty-panel p-12 text-center">
          <Icon name="lucide:inbox" class="mx-auto h-10 w-10 text-muted-foreground" />
          <p class="mt-3 text-muted-foreground">{shared.noArticles}</p>
        </div>
      ) : dealView ? (
        <DealsOverview
          merchants={merchants}
          labels={shared.codesTable ?? {}}
          copiedText={shared.copied}
        />
      ) : (
        <div class="space-y-8">
          {featured && (
            <article class="featured-guide" aria-labelledby="featured-guide-title">
              <div class="featured-guide__media">
                <div class="featured-guide__frame">
                  {featured.data.image ? (
                    <ArticleCover
                      src={featured.data.image}
                      alt=""
                      loading="eager"
                      sizes="(max-width: 1023px) calc(100vw - 2rem), 38rem"
                      widths={[400, 800, 1200]}
                      height={Math.round(800 * featured.data.image.height / featured.data.image.width)}
                      class="featured-guide__image"
                    />
                  ) : <WorldArt decorative />}
                </div>
              </div>
              <div class="featured-guide__content">
                <div class="featured-guide__labels">
                  <p class="featured-guide__eyebrow">{shared.featuredLabel}</p>
                  <span class="featured-guide__category">{nav[category] ?? category}</span>
                </div>
                <h2 id="featured-guide-title" class="featured-guide__title">
                  {featured.data.title}
                </h2>
                <p class="featured-guide__description">{featured.data.summary || featured.data.description}</p>
                <ArticleCardMeta
                  readTime={readTime(featured)}
                  meta={stamp(featured)}
                  date={featured.data.lastModified ?? featured.data.date}
                />
                <a
                  href={detailPath(category, parseEntryId(featured.id)?.slug ?? '', locale)}
                  class="featured-guide__cta"
                  aria-describedby="featured-guide-title"
                >
                  {shared.readTheGuide}
                  <Icon name="lucide:arrow-up-right" class="h-4 w-4" aria-hidden="true" />
                </a>
              </div>
            </article>
          )}
          {rest.length > 0 && (
            <div>
              <h2 class="font-display text-2xl font-semibold tracking-tight">{shared.allPages}</h2>
              <div class="article-list-grid mt-4">
                {rest.map((entry) => {
                  const slug = parseEntryId(entry.id)?.slug ?? '';
                  return (
                    <ArticleCard
                      href={detailPath(category, slug, locale)}
                      title={entry.data.title}
                      description={entry.data.description}
                      meta={stamp(entry)}
                      date={entry.data.lastModified ?? entry.data.date}
                      readTime={readTime(entry)}
                      image={entry.data.image}
                      heading="h3"
                    />
                  );
                })}
              </div>
            </div>
          )}
        </div>
      )
    }
    {
      exploreLinks.length > 0 && (
        <nav aria-label={shared.keepExploring}>
          <h2 class="text-xl font-bold tracking-tight">{shared.keepExploring}</h2>
          <ul class="mt-3 flex list-none flex-wrap gap-2 p-0">
            {exploreLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="inline-flex min-h-11 items-center rounded-full border border-border bg-card px-4 text-sm font-medium text-nav hover:border-nav"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
    {entries.length > 0 && <PlayCta locale={locale} />}
  </div>
</LocaleLayout>

<style>
  .featured-guide {
    display: grid;
    min-width: 0;
    overflow: hidden;
    border: 1px solid hsl(var(--brand) / 0.23);
    border-radius: calc(var(--radius) + 0.5rem);
    background: hsl(var(--card));
    box-shadow: 0 16px 40px -28px hsl(var(--brand) / 0.35);
  }

  .featured-guide__media {
    display: grid;
    align-items: center;
    min-width: 0;
    background: hsl(var(--muted));
  }

  /* The image keeps its own ratio even when the text panel is taller.
     Contain preserves edge labels on both old covers and replacement art. */
  .featured-guide__frame {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    isolation: isolate;
  }

  .featured-guide__frame::after {
    position: absolute;
    inset: 0;
    content: '';
    pointer-events: none;
    background: linear-gradient(180deg, hsl(var(--brand) / 0), hsl(var(--brand) / 0.08));
  }

  .featured-guide__frame :global(.featured-guide__image) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }

  .featured-guide__content {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 1rem;
    padding: clamp(1.25rem, 3vw, 2.25rem);
    background: radial-gradient(ellipse at 100% 0%, hsl(var(--brand) / 0.055), hsl(var(--card) / 0) 70%);
  }

  .featured-guide__labels {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.875rem;
    color: hsl(var(--brand-text));
  }

  .featured-guide__eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .featured-guide__category {
    border: 1px solid hsl(var(--brand) / 0.2);
    border-radius: 999px;
    padding: 0.25rem 0.625rem;
    background: hsl(var(--brand) / 0.07);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .featured-guide__title {
    color: hsl(var(--foreground));
    font-size: clamp(1.625rem, 2.5vw, 2rem);
    font-weight: 700;
    line-height: 1.18;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .featured-guide__description {
    color: hsl(var(--muted-foreground));
    font-size: 1rem;
    line-height: 1.6;
  }

  .featured-guide__cta {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 0.25rem;
    border: 1px solid hsl(var(--brand));
    border-radius: 0.75rem;
    padding: 0.75rem 1.125rem;
    background: hsl(var(--brand));
    color: hsl(var(--background));
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .featured-guide__cta:hover {
    background: hsl(var(--brand-text));
    border-color: hsl(var(--brand-text));
  }

  .featured-guide__cta:focus-visible {
    outline: 3px solid hsl(var(--brand-text));
    outline-offset: 4px;
  }

  .featured-guide:focus-within {
    border-color: hsl(var(--brand));
    box-shadow: 0 12px 36px -20px hsl(var(--brand) / 0.3);
  }

  .article-list-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .article-list-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .featured-guide {
      grid-template-columns: 1.08fr 1fr;
    }

    .featured-guide__media {
      border-inline-end: 1px solid hsl(var(--brand) / 0.15);
    }

    .article-list-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .featured-guide {
      transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
    }

    @media (hover: hover) {
      .featured-guide:hover {
        transform: translateY(-3px);
        border-color: hsl(var(--brand) / 0.45);
        box-shadow: 0 18px 40px -22px hsl(var(--brand) / 0.3);
      }
    }
  }
</style>
