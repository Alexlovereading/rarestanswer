---
/**
 * Site footer — trivia categories, reading links, legal, data credit.
 * Labels come from locale JSON. External socials render only when the
 * URL is set and is not this site.
 */
import { site, siteUrl } from '~/config/site';
import { type Locale } from '~/i18n/routing';
import { getUi } from '~/i18n/ui';
import { homeUrl, localizePath, recentPath, tagsPath } from '~/lib/url';
import BrandMark from '~/components/layout/BrandMark.astro';
import CategoryArt from '~/components/art/CategoryArt.astro';
import { Icon } from 'astro-icon/components';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const ui = getUi(locale);
const footer = ui.footer;
const shared = ui.shared;
const nav = ui.nav;

const selfHosts = new Set(
  [siteUrl, `https://${site.domain}`, `http://${site.domain}`].map((u) => u.replace(/\/$/, '')),
);

type SocialLink = {
  key: 'officialDiscord' | 'officialYoutube' | 'officialTwitter' | 'officialReddit' | 'playGame';
  href: string;
};
const socials = (
  [
    { key: 'officialDiscord', href: site.social.discord },
    { key: 'officialYoutube', href: site.social.youtube },
    { key: 'officialTwitter', href: site.social.twitter },
    { key: 'officialReddit', href: site.social.reddit },
    { key: 'playGame', href: site.social.official },
  ] as Array<{ key: SocialLink['key']; href: string | undefined }>
).filter(
  (s): s is SocialLink =>
    typeof s.href === 'string' && s.href.length > 0 && !selfHosts.has(s.href.replace(/\/$/, '')),
);

const triviaKeys = [
  'geography',
  'animals',
  'food',
  'sports',
  'screen',
  'music',
  'science',
  'history',
] as const;

const readLinks = [
  { href: homeUrl(locale), label: nav.play },
  { href: localizePath('/unlimited/', locale), label: nav.unlimited },
  { href: localizePath('/rarest-answers/', locale), label: nav.rarestAnswers },
  { href: localizePath('/games/', locale), label: nav.games },
  { href: localizePath('/guides/', locale), label: nav.guides },
  { href: recentPath(locale), label: shared.recentTitle },
  { href: tagsPath(locale), label: shared.allTags },
];

const legalLinks: Array<{ key: keyof typeof footer; path: string }> = [
  { key: 'about', path: '/about/' },
  { key: 'dataUpdates', path: '/data-updates/' },
  { key: 'faq', path: '/faq/' },
  { key: 'privacyPolicy', path: '/privacy-policy/' },
  { key: 'termsOfService', path: '/terms-of-service/' },
  { key: 'copyright', path: '/copyright/' },
  { key: 'contact', path: '/contact/' },
];
---

<footer class="mt-20 border-t border-border bg-muted/50">
  <div class="h-px bg-gradient-to-r from-transparent via-gold/70 to-transparent" aria-hidden="true"></div>
  <div class="mx-auto max-w-7xl px-4 py-12">
    <nav class="footer-worlds" aria-label={footer.trivia}>
      {triviaKeys.map((key) => (
        <a href={localizePath(`/trivia/${key}/`, locale)} class="footer-worlds__link">
          <CategoryArt category={key} size={48} decorative />
          <span>{shared.categories[key]}</span>
        </a>
      ))}
    </nav>
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <a href={homeUrl(locale)} class="flex items-center gap-2 font-display text-lg font-semibold">
          <BrandMark class="h-7 w-7" />
          <span>{site.name}</span>
        </a>
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-muted-foreground">{site.tagline}</p>
        <a href={homeUrl(locale)} class="btn-primary mt-4 gap-2 px-4 py-2">
          <Icon name="lucide:play" class="h-4 w-4" aria-hidden="true" />
          {nav.play}
        </a>
        <p class="mt-4 text-xs text-muted-foreground">{footer.dataAttribution}</p>
        {
          socials.length > 0 && (
            <ul class="mt-3 space-y-2">
              {socials.map((s) => (
                <li>
                  <a
                    href={s.href}
                    rel="noopener noreferrer"
                    target="_blank"
                    class="text-sm text-foreground/80 transition hover:text-nav"
                  >
                    {footer[s.key]}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <div>
        <h2 class="font-display text-sm font-semibold tracking-tight text-foreground">
          {footer.trivia}
        </h2>
        <ul class="mt-3 grid grid-cols-2 gap-x-3 gap-y-2">
          {
            triviaKeys.map((key) => (
              <li>
                <a
                  href={localizePath(`/trivia/${key}/`, locale)}
                  class="inline-flex min-h-11 items-center text-sm text-foreground hover:text-nav sm:min-h-0"
                >
                  {shared.categories[key]}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="font-display text-sm font-semibold tracking-tight text-foreground">
          {footer.read}
        </h2>
        <ul class="mt-3 space-y-1">
          {
            readLinks.map((link) => (
              <li>
                <a href={link.href} class="inline-flex min-h-11 items-center text-sm text-foreground hover:text-nav sm:min-h-0">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="font-display text-sm font-semibold tracking-tight text-foreground">
          {footer.legal}
        </h2>
        <ul class="mt-3 space-y-1">
          {
            legalLinks.map((item) => (
              <li>
                <a
                  href={localizePath(item.path, locale)}
                  class="inline-flex min-h-11 items-center text-sm text-foreground hover:text-nav sm:min-h-0"
                >
                  {footer[item.key]}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="mt-8 space-y-1 border-t border-border pt-6">
      {footer.copyrightText && <p class="text-xs text-muted-foreground">{footer.copyrightText}</p>}
      {site.legalNotice && <p class="text-xs text-muted-foreground">{site.legalNotice}</p>}
    </div>
  </div>
</footer>
