---
/** Static, lazy art. Templates stay inert until the controller shows a reaction. */
import { NOVA_ALT } from '~/lib/game/copy';
import type { NovaMood } from '~/lib/game/visuals';

interface Props { mood: NovaMood | 'waving' }
const { mood } = Astro.props;
---

<img
  src={`/images/world/nova-${mood}-160x160.webp`}
  srcset={`/images/world/nova-${mood}-160x160.webp 160w, /images/world/nova-${mood}-320x320.webp 320w`}
  sizes="(min-width: 640px) 160px, 112px"
  width="160"
  height="160"
  alt={NOVA_ALT[mood]}
  loading="lazy"
  decoding="async"
  draggable="false"
/>
