---
interface LinkItem {
  href: string;
  label: string;
}

interface Props {
  title: string;
  links: readonly LinkItem[];
  id?: string;
}

const { title, links, id } = Astro.props;
---

<section class="mt-16" id={id}>
  <h2 class="text-2xl font-bold tracking-tight text-foreground">{title}</h2>
  <ul class="mt-4 grid gap-2 sm:grid-cols-2">
    {
      links.map((link) => (
        <li>
          <a
            href={link.href}
            class="block rounded-lg border bg-card px-4 py-3 text-sm font-medium text-nav hover:border-nav"
          >
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</section>
