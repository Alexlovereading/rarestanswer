---
/**
 * Site header — gem wordmark, primary nav, search, theme.
 * Desktop nav from the lg breakpoint (the "Games like Krillion" label
 * needs the room). Below that, a native <details> menu. Search stays
 * visible at every width.
 */
import { Icon } from 'astro-icon/components';
import { site } from '~/config/site';
import { type Locale, defaultLocale, locales, LOCALE_LABELS } from '~/i18n/routing';
import { getUi } from '~/i18n/ui';
import { homeUrl, localizePath } from '~/lib/url';
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import SearchButton from './SearchButton.astro';
import BrandMark from '~/components/layout/BrandMark.astro';
import { landingLink, landingLinkEnabled, zhLandingLink } from '~/config/project';

interface Props {
  locale: Locale;
  currentPath: string;
  /**
   * Locales the current page exists in (optional). Pages that DON'T fall
   * back to English (tag pages) pass their real coverage so the language
   * switcher never links to a 404.
   */
  availableLocales?: readonly Locale[];
}
const { locale, currentPath, availableLocales } = Astro.props;
const ui = getUi(locale);
const nav = ui.nav;

const headerLocales = availableLocales ?? locales;
const showLanguages = headerLocales.length > 1;

const localePrefixRe = new RegExp(
  `^/(${locales.filter((l) => l !== defaultLocale).join('|')})(?=/|$)`,
);

const samePagePathFor = (loc: Locale) => {
  const stripped = currentPath.replace(localePrefixRe, '') || '/';
  const isHome = stripped === '/' || (landingLinkEnabled && stripped === '/demo/');
  return isHome ? homeUrl(loc) : localizePath(stripped, loc);
};

const nameParts = site.name.split(' ');
const wordmarkLead = nameParts.length > 1 ? nameParts.slice(0, -1).join(' ') : site.name;
const wordmarkTail = nameParts.length > 1 ? nameParts[nameParts.length - 1] : '';

interface ChromeLink {
  href: string;
  label: string;
  icon: string;
  exact?: boolean;
  also?: string[];
  /** Filled pill. The daily game stays the primary action at every width. */
  emphasis?: boolean;
}

const chromeNav: ChromeLink[] = [
  { href: homeUrl(locale), label: nav.play, icon: 'lucide:play', exact: true, emphasis: true },
  { href: localizePath('/unlimited/', locale), label: nav.unlimited, icon: 'lucide:infinity' },
  {
    href: localizePath('/rarest-answers/', locale),
    label: nav.rarestAnswers,
    icon: 'lucide:gem',
    also: [localizePath('/answers/', locale)],
  },
  { href: localizePath('/games/', locale), label: nav.games, icon: 'lucide:gamepad-2' },
  { href: localizePath('/guides/', locale), label: nav.guides, icon: 'lucide:book-open' },
];

const pathActive = (href: string, exact = false) => {
  if (exact || href === '/') return currentPath === href;
  return currentPath === href || currentPath.startsWith(href);
};

const itemActive = (item: ChromeLink) =>
  pathActive(item.href, item.exact) || (item.also ?? []).some((href) => pathActive(href));
---

<header class="site-chrome-header sticky top-0 z-40 w-full bg-background">
  <div class="mx-auto flex h-14 max-w-7xl items-center gap-3 px-4">
    <a
      href={homeUrl(locale)}
      class="flex min-w-0 items-center gap-2 text-foreground"
    >
      <BrandMark class="h-8 w-8 shrink-0" />
      <span class="truncate font-display text-[0.95rem] font-semibold leading-none tracking-tight sm:text-base">
        {wordmarkLead}{wordmarkTail && ' '}
        {wordmarkTail && <span class="text-nav">{wordmarkTail}</span>}
      </span>
    </a>

    <nav class="hidden min-w-0 flex-1 items-center gap-0.5 lg:flex" aria-label={nav.mainMenu}>
      {
        chromeNav.map((item) => {
          const isActive = itemActive(item);
          return (
            <a
              href={item.href}
              aria-current={isActive ? 'page' : undefined}
              class:list={[
                'whitespace-nowrap text-sm font-medium',
                item.emphasis
                  ? 'btn-primary px-3 py-1.5'
                  : isActive
                    ? 'rounded-full bg-[hsl(var(--brand-text)/0.12)] px-2.5 py-1.5 text-nav xl:px-3'
                    : 'rounded-full px-2.5 py-1.5 text-foreground hover:bg-muted xl:px-3',
                item.emphasis && isActive && 'ring-2 ring-gold/70 ring-offset-2 ring-offset-background',
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <div class="ml-auto flex shrink-0 items-center gap-1">
      {
        landingLinkEnabled && (
          <a
            href={landingLink.href}
            class="inline-flex h-9 items-center gap-1.5 rounded-full px-2 text-xs font-medium text-muted-foreground transition hover:bg-muted hover:text-nav"
            aria-label={landingLink.ariaLabel}
            title={landingLink.ariaLabel}
          >
            <Icon name="lucide:hammer" class="h-5 w-5 shrink-0" />
            <span class="hidden whitespace-nowrap lg:inline">{landingLink.label}</span>
          </a>
        )
      }
      <SearchButton locale={locale} />
      <ThemeToggle />
      {showLanguages && (
        <LanguageSwitcher
          locale={locale}
          pathFor={samePagePathFor}
          availableLocales={availableLocales}
        />
      )}

      <details class="group lg:hidden" data-mobile-nav>
        <summary
          class="inline-flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-full text-foreground hover:bg-muted [&::-webkit-details-marker]:hidden"
          aria-label={nav.menu}
        >
          <Icon name="lucide:menu" class="h-5 w-5 group-open:hidden" aria-hidden="true" />
          <Icon name="lucide:x" class="hidden h-5 w-5 group-open:block" aria-hidden="true" />
        </summary>
        <div
          class="absolute inset-x-0 top-full z-50 overflow-y-auto border-t border-border bg-background px-4 py-3"
          style="height: calc(100dvh - 100%)"
        >
          <button
            type="button"
            data-open-search
            class="flex min-h-11 w-full items-center gap-3 rounded-xl px-3 text-sm font-medium text-nav hover:bg-muted"
          >
            <Icon name="lucide:search" class="h-4 w-4" aria-hidden="true" />
            <span>{nav.search}</span>
          </button>
          {
            chromeNav.map((item) => (
              <a
                href={item.href}
                aria-current={itemActive(item) ? 'page' : undefined}
                class:list={[
                  'flex min-h-11 items-center gap-3 rounded-xl px-3 text-base hover:bg-muted',
                  item.emphasis && 'mt-1 font-semibold text-nav',
                  itemActive(item) && !item.emphasis && 'bg-[hsl(var(--brand-text)/0.12)] font-semibold text-nav',
                ]}
              >
                <Icon name={item.icon} class="h-4 w-4 shrink-0 text-nav" aria-hidden="true" />
                {item.label}
              </a>
            ))
          }
          {
            showLanguages && (
              <div class="border-t border-border pt-1">
                <div class="flex items-center gap-1 px-3 pb-1 text-xs text-muted-foreground">
                  <Icon name="lucide:globe" class="h-3 w-3" />
                  <span>{nav.language}</span>
                </div>
                {
                  headerLocales.map((loc) => (
                    <a
                      href={samePagePathFor(loc)}
                      class:list={[
                        'block px-3 py-2 text-sm transition hover:bg-muted',
                        loc === locale && 'font-semibold text-nav',
                      ]}
                    >
                      {LOCALE_LABELS[loc]}
                    </a>
                  ))
                }
                {
                  landingLinkEnabled && (
                    <a
                      href={zhLandingLink.href}
                      class="block border-t border-border px-3 py-2 text-sm text-muted-foreground transition hover:bg-muted hover:text-nav"
                    >
                      {zhLandingLink.label}
                    </a>
                  )
                }
              </div>
            )
          }
          {
            landingLinkEnabled && (
              <a
                href={landingLink.href}
                class="mt-1 flex items-center gap-2 border-t border-border px-3 py-2 text-sm text-muted-foreground transition hover:bg-muted hover:text-nav"
              >
                <Icon name="lucide:hammer" class="h-4 w-4" />
                <span>{landingLink.label}</span>
              </a>
            )
          }
        </div>
      </details>
    </div>
  </div>
  <div
    class="h-px bg-gradient-to-r from-transparent via-gold/70 to-transparent"
    aria-hidden="true"
  >
  </div>
</header>

<script>
  // Full-screen mobile menu: lock the page, close on Escape, and close
  // when search opens so the dialog is not sitting under the sheet.
  const menu = document.querySelector('[data-mobile-nav]');
  if (menu instanceof HTMLDetailsElement) {
    const summary = menu.querySelector('summary');
    const sync = () => {
      if (summary) summary.setAttribute('aria-expanded', menu.open ? 'true' : 'false');
      document.body.style.overflow = menu.open ? 'hidden' : '';
    };
    sync();
    menu.addEventListener('toggle', sync);
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) menu.open = false;
    });
    const searchButtons = document.querySelectorAll('[data-open-search]');
    for (const button of searchButtons) {
      button.addEventListener('click', () => {
        if (menu.open) menu.open = false;
      });
    }
  }
</script>
