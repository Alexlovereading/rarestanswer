---
import AdSenseSlot from './AdSenseSlot.astro';
import AdsterraSlot from './AdsterraSlot.astro';
import HouseAd from './HouseAd.astro';
import { resolvePlacement, type Placement } from './placements';
import { getUi } from '~/i18n/ui';

interface Props {
  placement: Placement;
}
const { placement } = Astro.props;
const ad = resolvePlacement(import.meta.env, placement);
const label = getUi(Astro.currentLocale ?? 'en').shared.adLabel;
---

{
  ad.provider !== 'none' && (
    <div
      class:list={['site-ad-unit', { 'site-ad-placeholder': ad.provider === 'placeholder' }]}
      data-site-ad={placement}
      data-ad-provider={ad.provider}
      style={`--ad-width:${ad.width}px;--ad-height:${ad.height}px`}
      role={ad.provider === 'placeholder' ? 'note' : 'group'}
      aria-label={label}
    >
      {ad.provider !== 'house' && <span class="site-ad-label">{label}</span>}
      {ad.provider === 'house' && ad.houseAd && <HouseAd ad={ad.houseAd} placement={placement} />}
      {ad.provider === 'adsense' && (
        <AdSenseSlot
          position={placement}
          responsive={false}
          width={ad.width}
          height={ad.height}
          managed
        />
      )}
      {ad.provider === 'adsterra' && (
        <AdsterraSlot
          name={ad.adsterra}
          width={ad.width}
          height={ad.height}
          label={false}
          managed
        />
      )}
    </div>
  )
}
