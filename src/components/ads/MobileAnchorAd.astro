---
/**
 * Site-wide bottom anchor: desktop 728×90 / mobile 320×50.
 * The old article-level <MobileAnchorAd /> is intentionally a no-op: BaseLayout
 * now owns the one global mount. `siteWide` prevents duplicate article bars.
 * The shared controller remembers dismissal in sessionStorage, defers real
 * units until consent, and only loads the variant matching the viewport.
 */
import ReservedAdSlot from './ReservedAdSlot.astro';
import { resolveSiteAds } from './placements';
import { getUi } from '~/i18n/ui';
interface Props { siteWide?: boolean; }
const { siteWide = false } = Astro.props;
const ads = resolveSiteAds(import.meta.env);
const show = siteWide && (ads.desktop.provider !== 'none' || ads.mobile.provider !== 'none');
const control = siteWide && Object.values(ads).some((ad) => ad.provider !== 'none');
const closeAd = getUi(Astro.currentLocale ?? 'en').shared.closeAd;
---

{show && (
  <aside id="site-anchor-ad" hidden data-pagefind-ignore>
    {ads.desktop.provider !== 'none' && <div class="site-anchor-desktop"><ReservedAdSlot placement="desktop" /></div>}
    {ads.mobile.provider !== 'none' && <div class="site-anchor-mobile"><ReservedAdSlot placement="mobile" /></div>}
    <button id="dismiss-site-anchor" type="button" aria-label={closeAd}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
        <path d="m6 6 12 12M18 6 6 18" />
      </svg>
    </button>
  </aside>
)}

{control && (
  <script is:inline>
    /* Runs inline only when a shell placement exists. ES2018; no network in preview mode. */
    (function () {
      var CONSENT_KEY = 'aw-cookie-consent';
      var CONSENT_EVENT = 'aw:consent-accepted';
      var root = document.documentElement;
      var anchor = document.getElementById('site-anchor-ad');
      var close = document.getElementById('dismiss-site-anchor');
      var desktop = window.matchMedia('(min-width: 768px)');
      var wide = window.matchMedia('(min-width: 1440px) and (min-height: 860px)');
      var consent = false;
      try { consent = localStorage.getItem(CONSENT_KEY) === 'accepted'; } catch (e) { /* unavailable */ }

      function isVisible(unit) {
        var placement = unit.getAttribute('data-site-ad');
        if (placement === 'left' || placement === 'right') return wide.matches;
        if (!root.classList.contains('has-site-ad-anchor')) return false;
        return placement === 'desktop' ? desktop.matches : !desktop.matches;
      }

      function refresh() {
        var units = document.querySelectorAll('[data-site-ad]');
        var anchorVisible = false;
        for (var i = 0; i < units.length; i++) {
          var unit = units[i];
          var provider = unit.getAttribute('data-ad-provider');
          var ready = isVisible(unit) && (provider === 'placeholder' || consent);
          unit.classList.toggle('site-ad-ready', ready);
          if (!ready) continue;
          var placement = unit.getAttribute('data-site-ad');
          if (placement === 'desktop' || placement === 'mobile') {
            anchorVisible = true;
            // AdSense measures synchronously when its queue is already loaded.
            if (anchor) anchor.hidden = false;
          }
          // Hidden rail / alternate anchor variants never request inventory.
          var frame = unit.querySelector('iframe[data-ad-managed]');
          if (frame) {
            frame.src = frame.getAttribute('data-src');
            frame.removeAttribute('data-src');
            frame.removeAttribute('data-ad-managed');
          }
          var ins = unit.querySelector('ins[data-ad-managed]');
          if (ins) {
            ins.removeAttribute('data-ad-managed');
            window.adsbygoogle = window.adsbygoogle || [];
            window.adsbygoogle.push({});
          }
        }
        if (anchor) anchor.hidden = !anchorVisible;
      }

      if (anchor && !root.classList.contains('has-site-ad-anchor')) anchor.remove();
      if (close) close.addEventListener('click', function () {
        try { sessionStorage.setItem('site-anchor-dismissed', '1'); } catch (e) { /* unavailable */ }
        root.classList.remove('has-site-ad-anchor');
        // A later consent event must never resurrect a dismissed bar.
        if (anchor) anchor.remove();
        refresh();
      });
      document.addEventListener(CONSENT_EVENT, function () { consent = true; refresh(); });
      [desktop, wide].forEach(function (query) {
        if (query.addEventListener) query.addEventListener('change', refresh);
        else window.addEventListener('resize', refresh);
      });
      refresh();
    })();
  </script>
)}
