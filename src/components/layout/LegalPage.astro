---
/**
 * LegalPage layout — wraps legal pages (About/Privacy/Terms/Copyright).
 *
 * Per PRD, legal page body text is hardcoded English (not translated) but
 * the surrounding chrome (nav, footer, theme) respects the current locale.
 */
import { Icon } from 'astro-icon/components';
import LocaleLayout from './LocaleLayout.astro';
import { type Locale } from '~/i18n/routing';
import { site } from '~/config/site';
import { getUi } from '~/i18n/ui';
import { homeUrl } from '~/lib/url';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  /** ISO date string for "last updated". */
  lastUpdated?: string;
}
const { locale, title, description = `${title} for ${site.name}.`, lastUpdated } = Astro.props;
const ui = getUi(locale);
---

<LocaleLayout locale={locale} title={title} description={description}>
  <article class="mx-auto max-w-[42rem]">
    <nav class="flex flex-wrap items-center gap-1 text-sm text-muted-foreground" aria-label={ui.shared.breadcrumbAria}>
      <a href={homeUrl(locale)} class="hover:text-nav">{ui.nav.home}</a>
      <Icon name="lucide:chevron-right" class="h-3.5 w-3.5" aria-hidden="true" />
      <span class="text-foreground">{title}</span>
    </nav>
    <h1 class="mt-4 font-display text-4xl font-extrabold tracking-tight text-balance md:text-5xl">{title}</h1>
    {lastUpdated && (
      <p class="mt-3 text-sm text-muted-foreground">{ui.shared.lastUpdated}: {lastUpdated}</p>
    )}
    <div
      class="prose prose-lg mt-8 max-w-none dark:prose-invert prose-headings:scroll-mt-20 prose-a:text-nav"
    >
      <slot />
    </div>
    <slot name="after" />
  </article>
</LocaleLayout>
