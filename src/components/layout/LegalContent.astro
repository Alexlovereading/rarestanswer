---
/**
 * LegalContent — the shared body for each legal page.
 * Renders different content based on the `page` prop. English only (per PRD).
 */
import { site } from '~/config/site';

interface Props {
  page: 'about' | 'privacy-policy' | 'terms-of-service' | 'copyright' | 'contact';
}
const { page } = Astro.props;
const game = site.game.name;
const year = new Date().getFullYear();
const officialHref = site.social.official?.replace(/\/$/, '') ?? '';
const officialIsSelf =
  officialHref === `https://${site.domain}` || officialHref === `http://${site.domain}`;
---

{
  page === 'about' && (
    <>
      <p>
        {site.name} is a free daily trivia game you play in the browser. Each prompt has many
        correct answers. A rarer correct answer scores more.
      </p>
      <p>
        The site also publishes guides for the game and unofficial pages about other daily trivia
        games. Those pages are not affiliated with or endorsed by the games they describe.
      </p>
      <h2>What you can do here</h2>
      <ul>
        <li>Play the daily round</li>
        <li>Play Unlimited, or a single trivia category</li>
        <li>Read lists of rarest answers</li>
        <li>Read guides on how to play and how to find rare answers</li>
      </ul>
      <h2>Where the answers come from</h2>
      <p>
        Prompt lists are compiled from Wikidata (CC0) and Wikipedia pageview counts. An answer is
        ranked only against the other answers to the same prompt. A real name can be missing when
        that public data does not include it. The sample prompt still on the site is marked as a
        fixture, and its popularity numbers are placeholders, not live pageviews.
      </p>
      <h2>Contact</h2>
      <p>
        {site.contactEmail ? (
          <>
            Email <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>.
          </>
        ) : (
          <>No separate contact email is published on this site.</>
        )}
      </p>
    </>
  )
}

{
  page === 'privacy-policy' && (
    <>
      <p>
        This privacy policy describes how {site.name} ("we", "us", or "our") handles information
        when you visit this website.
      </p>
      <h2>Information We Collect</h2>
      <p>
        {site.name} is a static website. We do not require you to create an account or submit
        personal information. We do not directly collect or store personal data.
      </p>
      <h2>Third-Party Services</h2>
      <p>
        When a third-party service is enabled, it may collect information as described in its own
        privacy policy. Nothing in the list below loads unless that service is configured:
      </p>
      <ul>
        <li>
          <strong>Advertising partners</strong> (e.g. Google AdSense, Adsterra) — may use cookies to
          serve relevant ads. You can opt out of personalized advertising via your browser settings.
        </li>
        <li>
          <strong>Analytics</strong> (e.g. Google Analytics, Cloudflare Web Analytics, VibeCafé) —
          GA may collect anonymized usage data such as page views and approximate location
          (cookie-based, loaded only after you accept the consent banner); Cloudflare Web Analytics
          is cookieless and collects aggregate page-view data. VibeCafé (optional product
          telemetry, loaded only when the site owner enables it) collects page-visit data.
        </li>
        <li>
          <strong>Cloudflare</strong> — our hosting provider, which may process basic request data
          for security and performance (and serve Web Analytics when enabled, see above).
        </li>
        <li>
          <strong>Comments</strong> (giscus, opt-in) — when the comment section is enabled,
          giscus.app loads an embedded GitHub view; viewing it exposes your IP address and browser
          info to that service, and signing in to comment is handled by GitHub under its own
          privacy policy.
        </li>
        <li>
          <strong>Embedded videos</strong> (YouTube) — pages with videos load thumbnail images
          from i.ytimg.com and, after you press play, the YouTube player from youtube-nocookie.com.
          Until you interact, no YouTube cookies are set.
        </li>
      </ul>
      <h2>Cookies</h2>
      <p>
        Some third-party services set cookies. You can control cookies through your browser
        settings. Disabling cookies may affect ad personalization but will not prevent you from
        accessing site content.
      </p>
      <h2>Children's Privacy</h2>
      <p>
        {site.name} is not directed at children under 13, and we do not knowingly collect
        information from children.
      </p>
      <h2>Changes to This Policy</h2>
      <p>We may update this policy from time to time. Changes will be posted on this page.</p>
    </>
  )
}

{
  page === 'terms-of-service' && (
    <>
      <p>By accessing {site.name}, you agree to the following terms of service.</p>
      <h2>Use of Content</h2>
      <p>
        All guides, articles, and reference material on this site are provided for personal,
        non-commercial use. You may not copy, republish, or redistribute our content without
        attribution and a link back to the original page.
      </p>
      <h2>Accuracy</h2>
      <p>
        Guides and answer lists can be incomplete or out of date. Rarity ranks come from public
        pageview statistics and can change. Check the game you are playing for its own rules. {game}{' '}
        does not promise that every valid answer is in a list.
      </p>
      <h2>Third-Party Links</h2>
      <p>
        This site may link to other websites. We do not control those sites and are not responsible
        for their content or practices.
      </p>
      <h2>Trademarks</h2>
      <p>
        Names of other games mentioned on this site belong to their owners. Pages about those games
        are unofficial and are not affiliated with or endorsed by them. {site.name} is an
        independent site.
      </p>
      <h2>Limitation of Liability</h2>
      <p>
        Use of this site is at your own risk. We are not liable for any damages arising from your
        use of the site or reliance on its content.
      </p>
      <h2>Changes to These Terms</h2>
      <p>
        We may revise these terms at any time. Continued use of the site after changes constitutes
        acceptance of the updated terms.
      </p>
    </>
  )
}

{
  page === 'copyright' && (
    <>
      <h2>Copyright Notice</h2>
      <p>
        © {year} {site.name}. Original articles and guides on this site belong to their authors.
      </p>
      <h2>Answer data</h2>
      <p>
        Answer lists use Wikidata and public Wikipedia pageview statistics. Wikidata is available
        under CC0. Pageview figures describe public readership. They are not a hand-written score.
      </p>
      <h2>Other games</h2>
      <p>
        Trademarks of other games remain with their owners. This site does not claim those names or
        any artwork that belongs to them.
      </p>
      <p>{site.legalNotice}</p>
      <h2>DMCA / Takedown</h2>
      <p>
        If you believe content on this site infringes your copyright, send a description of the
        material and where it appears
        {site.contactEmail ? (
          <>
            {' '}
            to <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>.
          </>
        ) : (
          <>
            . No separate email is published yet — use the{' '}
            <a href="/contact/">contact page</a>.
          </>
        )}
      </p>
    </>
  )
}

{
  page === 'contact' && (
    <>
      {/* h2, not h1 — LegalPage already renders the page H1 (single-H1 rule). */}
      <h2>Contact {site.name}</h2>
      <p>{site.name} is a free daily trivia game and the guides published with it.</p>
      <ul>
        {site.contactEmail && (
          <li>
            <strong>Email:</strong> <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
          </li>
        )}
        {officialHref && (
          <li>
            <strong>{officialIsSelf ? 'Site' : 'Official site'}:</strong>{' '}
            <a href={site.social.official} rel="noopener noreferrer">
              {officialHref}
            </a>
          </li>
        )}
        {site.social.discord && (
          <li>
            <strong>Discord:</strong>{' '}
            <a href={site.social.discord} target="_blank" rel="noopener noreferrer">
              {site.social.discord}
            </a>
          </li>
        )}
        {site.social.reddit && (
          <li>
            <strong>Reddit:</strong>{' '}
            <a href={site.social.reddit} target="_blank" rel="noopener noreferrer">
              {site.social.reddit}
            </a>
          </li>
        )}
        {site.social.youtube && (
          <li>
            <strong>YouTube:</strong>{' '}
            <a href={site.social.youtube} target="_blank" rel="noopener noreferrer">
              {site.social.youtube}
            </a>
          </li>
        )}
      </ul>
      {!site.contactEmail && <p>No separate contact email is published on this site.</p>}
      <h2>Copyright requests</h2>
      <p>
        For takedown requests, see the <a href="/copyright/">Copyright page</a>.
      </p>
    </>
  )
}
