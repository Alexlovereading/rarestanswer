---
import type { Answer } from '../../lib/game/types';
import { tierTreasure } from './raster-art';

interface Props {
  tier: Answer['tier'];
  size?: number;
}

const { tier, size = 64 } = Astro.props;
const dimension = Number.isFinite(size) && size > 0 ? size : 64;
const treasure = tierTreasure[tier];
const widths = [128, 192, 256, 384];
const srcset = widths
  .map((width) => `/images/tiers/${treasure.file}-${width}x${width}.webp ${width}w`)
  .join(', ');
---

{/* Tier names and points remain in surrounding HTML; the treasure adds its visual identity. */}
<picture
  class:list={['tier-badge', { 'tier-badge--legendary': tier === 6 }]}
  style={`width: ${dimension}px;`}
>
  <source type="image/webp" srcset={srcset} sizes={`${dimension}px`} />
  <img
    src={`/images/tiers/${treasure.file}-128x128.webp`}
    width={dimension}
    height={dimension}
    alt={treasure.alt}
    loading="lazy"
    decoding="async"
    draggable="false"
  />
</picture>

<style>
  .tier-badge {
    display: inline-block;
    flex: none;
    max-width: 100%;
    aspect-ratio: 1;
    vertical-align: middle;
    user-select: none;
  }
  .tier-badge img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
  }
</style>
