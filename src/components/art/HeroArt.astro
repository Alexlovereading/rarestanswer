---
import { observatoryAlt } from './raster-art';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

{/* The page hero owns LCP priority. Repeated world art loads lazily. */}
<picture class:list={['hero-art', className]}>
  <source
    type="image/webp"
    srcset="/images/world/hero-observatory-520x780.webp 520w, /images/world/hero-observatory-1040x1560.webp 1040w"
    sizes="(min-width: 1024px) 520px, 100vw"
  />
  <img
    src="/images/world/hero-observatory-520x780.webp"
    width="520"
    height="780"
    alt={observatoryAlt}
    loading="lazy"
    decoding="async"
    draggable="false"
  />
</picture>

<style>
  .hero-art {
    display: block;
    width: 100%;
    max-width: 520px;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    border-radius: 1.5rem;
    pointer-events: none;
    user-select: none;
  }
  .hero-art img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 3;
    object-fit: contain;
  }
</style>
