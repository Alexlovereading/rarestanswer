---
import { Icon } from 'astro-icon/components';
import CategoryArt from '~/components/art/CategoryArt.astro';
import { answerPath, getPrompt } from '~/components/answers/prompts';
import { rarestKeywordAnchor } from '~/config/trending-prompts';
import {
  answerCountLabel,
  LOBBY,
  promptCountLine,
  promptNoun,
  promptSectionTitle,
  type CatalogPrompt,
  type CategoryPageCopy,
} from '~/lib/game/category-copy';
interface Props {
  page: CategoryPageCopy;
  prompts: readonly CatalogPrompt[];
}
const { page, prompts } = Astro.props;

function anchorFor(prompt: CatalogPrompt): string {
  const full = getPrompt(prompt.slug);
  return rarestKeywordAnchor(full?.nounPhrase || full?.nounTitle || promptNoun(prompt.question));
}
---

<section id="prompts" class="category-prompts" aria-labelledby="prompts-title" data-pagefind-body>
  <header>
    <div class="prompt-heading-art">
      <CategoryArt category={page.key} size={80} />
    </div><div>
      <p class="eyebrow">{LOBBY.catalog}</p><h2 id="prompts-title">
        {promptSectionTitle(page.keyword)}
      </h2><p class="prompt-count">{promptCountLine(page.keyword, prompts.length)}</p>
    </div>
  </header>
  {
    prompts.length === 0 ? (
      <p class="mt-3">{page.emptyNote}</p>
    ) : (
      <>
        <p class="list-note">
          {page.listNote} Each link opens that prompt's ranked answers, rarest first. The full index
          is on{' '}
          <a class="text-nav underline underline-offset-2" href="/rarest-answers/">
            rarest answers
          </a>
          .
        </p>
        <ul>
          {prompts.map((prompt, index) => (
            <li class="prompt-card">
              <span class="prompt-number" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <div class="prompt-copy">
                <h3>
                  <a class="keyword-anchor" href={answerPath(prompt.slug)}>
                    {anchorFor(prompt)}
                  </a>
                </h3>
                <span class="answer-count">{answerCountLabel(prompt.answerCount)}</span>
              </div>
              <Icon name="lucide:arrow-up-right" aria-hidden="true" />
            </li>
          ))}
        </ul>
      </>
    )
  }
</section>

<style>
  .category-prompts {
    scroll-margin-top: 6rem;
  }
  header {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .prompt-heading-art {
    width: 80px;
    height: 80px;
    flex: 0 0 80px;
  }
  .eyebrow {
    color: hsl(var(--brand-text));
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  h2 {
    margin-top: 0.35rem;
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.025em;
  }
  .prompt-count {
    margin-top: 0.4rem;
    font-size: 0.9rem;
    color: hsl(var(--muted-foreground));
  }
  .list-note {
    max-width: 80ch;
    margin-top: 1.25rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.95rem;
    line-height: 1.6;
  }
  ul {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.5rem;
    list-style: none;
    padding: 0;
  }
  .prompt-card {
    position: relative;
    display: flex;
    align-items: start;
    gap: 0.875rem;
    min-width: 0;
    height: 100%;
    padding: 1.1rem;
    border: 1px solid hsl(var(--border));
    border-radius: 1rem;
    background: hsl(var(--card));
    transition:
      transform 0.2s,
      border-color 0.2s;
  }
  .prompt-card:hover {
    transform: translateY(-3px);
    border-color: hsl(var(--brand));
  }
  .prompt-card:focus-within {
    outline: 3px solid hsl(var(--brand));
    outline-offset: 3px;
  }
  .keyword-anchor {
    color: inherit;
    text-decoration: none;
  }
  .keyword-anchor::after {
    content: '';
    position: absolute;
    z-index: 1;
    inset: 0;
  }
  .keyword-anchor:focus-visible {
    outline: none;
  }
  .prompt-number {
    display: grid;
    place-items: center;
    min-width: 2rem;
    height: 2rem;
    border-radius: 0.5rem;
    background: hsl(var(--brand) / 0.08);
    color: hsl(var(--brand-text));
    font-size: 0.8rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .prompt-copy {
    min-width: 0;
    flex: 1;
  }
  h3 {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.3;
  }
  .answer-count {
    display: block;
    margin-top: 0.5rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.8125rem;
  }
  .prompt-card > :global(svg) {
    width: 16px;
    height: 16px;
    flex: 0 0 16px;
    margin-left: auto;
    color: hsl(var(--brand-text));
  }
  @media (min-width: 640px) {
    ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1050px) {
    ul {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .category-prompts * {
      animation: none !important;
      transition: none !important;
      transform: none !important;
    }
  }
</style>
