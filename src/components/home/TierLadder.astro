---
import TierBadge from '~/components/art/TierBadge.astro';
import { TIERS } from '~/lib/game/types';
import { TIER_BLURBS } from '~/lib/game/copy';
import { LOBBY } from '~/lib/game/category-copy';
---

<section id="tiers" class="tier-ladder" aria-labelledby="tiers-title" data-pagefind-body>
  <p class="eyebrow">{LOBBY.tierKicker}</p><h2 id="tiers-title">{LOBBY.tierTitle}</h2>
  <p class="tier-note">{LOBBY.tierNote}</p>
  <ol>
    {
      TIERS.map((row) => (
        <li style={`--tier-color: var(--tier-${row.tier})`}>
          <span class="badge">
            <TierBadge tier={row.tier} size={72} />
          </span>
          <>
            <h3>{row.name}</h3>
            <p class="tier-score">
              {row.points}
              <span> {LOBBY.points}</span>
            </p>
          </>
          <p class="tier-blurb">{TIER_BLURBS[row.tier]}</p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .eyebrow {
    color: hsl(var(--brand-text));
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  h2 {
    margin-top: 0.35rem;
    font-size: clamp(1.65rem, 2.7vw, 2rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.025em;
  }
  .tier-note {
    max-width: 65ch;
    margin-top: 0.75rem;
    color: hsl(var(--muted-foreground));
  }
  ol {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.65rem;
    margin-top: 1.5rem;
    padding: 0;
    list-style: none;
  }
  li {
    min-width: 0;
    padding: 1.1rem 0.5rem;
    border: 1px solid hsl(var(--tier-color) / 0.28);
    border-bottom: 3px solid hsl(var(--tier-color));
    border-radius: 1rem;
    background: linear-gradient(to bottom, hsl(var(--tier-color) / 0.07), hsl(var(--card)));
    text-align: center;
  }
  .badge {
    display: block;
    width: 72px;
    height: 72px;
    margin: 0 auto 0.75rem;
  }
  h3 {
    font-size: 0.925rem;
    font-weight: 700;
  }
  .tier-score {
    margin-top: 0.35rem;
    color: hsl(var(--tier-color));
    font-size: 1.5rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
  }
  .tier-score span {
    display: block;
    color: hsl(var(--muted-foreground));
    font-size: 0.75rem;
    font-weight: 400;
  }
  .tier-blurb {
    margin: 0.65rem auto 0;
    max-width: 16ch;
    color: hsl(var(--muted-foreground));
    font-size: 0.8125rem;
    line-height: 1.3;
  }
  @media (min-width: 800px) {
    ol {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 0.875rem;
    }
    li {
      padding-block: 1.5rem;
    }
    h3 {
      font-size: 1.05rem;
    }
    .tier-score span {
      display: inline;
    }
  }
</style>
