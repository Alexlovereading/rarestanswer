---
/**
 * FAQ accordion. Used by /faq. Native <details>, with a tiny inline script
 * that keeps aria-expanded in sync. Copy is passed in; this file has no
 * English of its own.
 */
import { Icon } from 'astro-icon/components';
import PlayCta from '~/components/article/PlayCta.astro';
import { type Locale } from '~/i18n/routing';

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  description?: string;
  items: FaqItem[];
  /** When set, a daily-game invitation renders under the accordion. */
  locale?: Locale;
}
const { title, description, items = [], locale } = Astro.props;
---

<section class="mx-auto max-w-3xl">
  <h1 class="font-display text-4xl font-extrabold tracking-tight text-balance md:text-5xl">{title}</h1>
  {description && <p class="mt-3 text-lg leading-relaxed text-muted-foreground">{description}</p>}
  <div class="mt-8 space-y-2" data-faq-group>
    {
      items.map((item: FaqItem) => (
        <details class="faq-item group">
          <summary aria-expanded="false">
            {item.question}
            <Icon
              name="lucide:chevron-down"
              class="h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180"
            />
          </summary>
          <div>{item.answer}</div>
        </details>
      ))
    }
  </div>
  {locale && <PlayCta locale={locale} />}
</section>

<script is:inline>
  // Sync aria-expanded on FAQ summaries when details toggle.
  // ES2018 only — untranspiled inline script, parsed by old webviews.
  document.querySelectorAll('[data-faq-group] details').forEach(function (d) {
    var sync = function () {
      var summary = d.querySelector('summary');
      if (summary) summary.setAttribute('aria-expanded', d.open ? 'true' : 'false');
    };
    sync();
    d.addEventListener('toggle', sync);
  });
</script>
