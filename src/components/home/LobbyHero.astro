---
import HeroArt from '~/components/art/HeroArt.astro';
import CategoryArt from '~/components/art/CategoryArt.astro';
import { LOBBY } from '~/lib/game/category-copy';
import type { CategoryKey } from '~/lib/game/types';

interface Props {
  kicker: string;
  title: string;
  lead?: string;
  category?: CategoryKey;
  count?: number;
}
const { kicker, title, lead, category, count } = Astro.props;
---

<section class="lobby-hero" aria-labelledby="lobby-title">
  <div class="hero-inner">
    <header class:list={['hero-heading', { 'category-heading': category }]} data-pagefind-body>
      <div>
        <p class="eyebrow"><span aria-hidden="true"></span>{kicker}</p>
        <h1 id="lobby-title">{title}</h1>
        {lead && <p class="hero-lead">{lead}</p>}
      </div>
      {
        category && (
          <div class="category-mark">
            <CategoryArt category={category} size={88} decorative />
          </div>
        )
      }
    </header>
    <div class="hero-play"><slot /></div>
    <aside
      class:list={['hero-visual', { 'category-art': category }]}
      aria-label={LOBBY.heroCaption}
    >
      {
        category ? (
          <div class="category-showcase">
            <CategoryArt category={category} size={280} />
          </div>
        ) : (
          <HeroArt />
        )
      }
      <div class="art-caption">
        <p>{category && count !== undefined ? `${count} ${LOBBY.prompts}` : LOBBY.heroCaption}</p>
        <span>{LOBBY.heroNote}</span>
      </div>
    </aside>
  </div>
</section>

<style>
  .lobby-hero {
    position: relative;
    isolation: isolate;
    border-bottom: 1px solid hsl(var(--border));
    background:
      radial-gradient(ellipse at 85% 35%, hsl(var(--brand-light) / 0.14), transparent 60%),
      hsl(var(--muted) / 0.3);
  }
  .lobby-hero::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(hsl(var(--brand) / 0.1) 1px, transparent 1px);
    background-size: 24px 24px;
    mask-image: linear-gradient(to right, transparent, hsl(var(--foreground)));
  }
  .hero-inner {
    display: grid;
    max-width: 1200px;
    margin-inline: auto;
    padding: 1.25rem 1rem 2rem;
    gap: 1rem;
  }
  .hero-heading {
    min-width: 0;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: hsl(var(--brand-text));
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .eyebrow span {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: hsl(var(--brand));
    box-shadow: 0 0 0 4px hsl(var(--brand) / 0.1);
  }
  h1 {
    margin-top: 0.5rem;
    max-width: 28ch;
    font-size: clamp(1.6rem, 3vw, 2.55rem);
    font-weight: 800;
    line-height: 1.13;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .hero-lead {
    margin-top: 0.5rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.975rem;
    line-height: 1.4;
  }
  .hero-play {
    min-width: 0;
  }
  .hero-play :global(.game-shell) {
    max-width: 100%;
  }
  /* Keep the game's compact scene on mobile; this page supplies the desktop scene. */
  .hero-play :global(.ra-lobby-intro) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.5rem;
  }
  .hero-play :global(.ra-lobby-hero) {
    flex: 0 0 104px;
    width: 104px;
    max-width: 104px;
  }
  .hero-visual {
    display: none;
  }
  .category-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .category-mark {
    flex: 0 0 72px;
    width: 72px;
    height: 72px;
  }
  .category-mark :global(svg),
  .category-mark :global(img) {
    width: 72px;
    height: 72px;
  }
  @media (min-width: 960px) {
    .hero-inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
      column-gap: 4rem;
      row-gap: 1.5rem;
      padding: 2.5rem 2rem 3rem;
    }
    .hero-heading {
      grid-column: 1;
    }
    .hero-play {
      grid-column: 1;
    }
    .hero-play :global(.ra-lobby-hero) {
      display: none;
    }
    .hero-visual {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-self: center;
      grid-column: 2;
      grid-row: 1 / 3;
      min-width: 0;
    }
    .hero-visual :global(.hero-art) {
      width: 100%;
    }
    .hero-visual > :global(.hero-art) {
      width: 100%;
      height: auto;
      aspect-ratio: 6 / 5;
    }
    .category-mark {
      display: none;
    }
    .category-showcase {
      aspect-ratio: 1;
      display: grid;
      place-items: center;
      border: 1px solid hsl(var(--brand) / 0.12);
      border-radius: 50%;
      background: radial-gradient(circle, hsl(var(--brand-light) / 0.15), transparent 68%);
    }
    .art-caption {
      margin-top: 0.5rem;
      text-align: center;
    }
    .art-caption p {
      font-family: Fraunces, serif;
      font-size: 1.35rem;
      font-weight: 700;
    }
    .art-caption span {
      display: block;
      max-width: 33ch;
      margin: 0.5rem auto 0;
      color: hsl(var(--muted-foreground));
      font-size: 0.95rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lobby-hero :global(*) {
      animation: none !important;
      transition: none !important;
      scroll-behavior: auto !important;
    }
  }
</style>
