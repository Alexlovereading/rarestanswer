---
import CategoryArt from '~/components/art/CategoryArt.astro';
import { LOBBY } from '~/lib/game/category-copy';
import type { CategoryKey } from '~/lib/game/types';

interface Props {
  kicker: string;
  title: string;
  lead?: string;
  category?: CategoryKey;
  count?: number;
}
const { kicker, title, lead, category, count } = Astro.props;
---

<section id="play" class="lobby-hero" aria-labelledby="lobby-title">
  <div class="hero-inner">
    <header class:list={['hero-heading', { 'category-heading': category }]} data-pagefind-body>
      <div>
        <p class="world-label">{LOBBY.world}</p>
        <p class="eyebrow"><span aria-hidden="true"></span>{kicker}</p>
        <h1 id="lobby-title">{title}</h1>
        {lead && <p class="hero-lead">{lead}</p>}
      </div>
      {
        category && (
          <div class="category-mark">
            <CategoryArt category={category} size={88} decorative />
          </div>
        )
      }
    </header>
    <div class="hero-play"><slot /></div>
    <aside
      class:list={['hero-visual', { 'category-art': category }]}
      aria-label={LOBBY.heroCaption}
    >
      <picture class="observatory-picture">
        <source
          type="image/webp"
          srcset="/images/world/hero-observatory-520x780.webp 520w, /images/world/hero-observatory-1040x1560.webp 1040w"
          sizes="(min-width: 1040px) 420px, 40vw"
        />
        <img
          src="/images/world/hero-observatory-520x780.webp"
          width="520"
          height="780"
          alt={LOBBY.heroAlt}
          fetchpriority="high"
          decoding="async"
        />
      </picture>
      <div class="art-caption">
        <p>{category && count !== undefined ? `${count} ${LOBBY.prompts}` : LOBBY.heroCaption}</p>
        <span>{LOBBY.heroNote}</span>
      </div>
    </aside>
  </div>
</section>

<style>
  .lobby-hero {
    position: relative;
    isolation: isolate;
    scroll-margin-top: 5rem;
    border-bottom: 1px solid hsl(var(--border));
    background:
      radial-gradient(ellipse at 85% 35%, hsl(var(--brand-light) / 0.2), transparent 60%),
      radial-gradient(ellipse at 10% 95%, hsl(var(--gold) / 0.07), transparent 40%),
      hsl(var(--muted) / 0.3);
  }
  .lobby-hero::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(hsl(var(--brand) / 0.1) 1px, transparent 1px);
    background-size: 24px 24px;
    mask-image: linear-gradient(to right, transparent, hsl(var(--foreground)));
  }
  .hero-inner {
    display: grid;
    max-width: 1040px;
    margin-inline: auto;
    padding: 1rem 1rem 2rem;
    gap: 1rem;
  }
  .hero-heading {
    min-width: 0;
  }
  .world-label {
    margin-bottom: 0.75rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: hsl(var(--brand-text));
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .eyebrow span {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: hsl(var(--brand));
    box-shadow: 0 0 0 4px hsl(var(--brand) / 0.1);
  }
  h1 {
    margin-top: 0.5rem;
    max-width: 21ch;
    font-size: clamp(1.6rem, 3vw, 2.65rem);
    font-weight: 800;
    line-height: 1.13;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .hero-lead {
    margin-top: 0.5rem;
    color: hsl(var(--muted-foreground));
    max-width: 42ch;
    font-size: 0.95rem;
    line-height: 1.4;
  }
  .hero-play {
    min-width: 0;
  }
  .hero-play :global(.game-shell) {
    max-width: 100%;
  }
  .hero-play :global([data-game-view='start']) {
    border-color: hsl(var(--brand) / 0.3);
    border-radius: 1.5rem;
    box-shadow:
      0 18px 48px -24px hsl(var(--brand) / 0.3),
      inset 0 1px 0 hsl(var(--foreground) / 0.04);
  }
  /* Keep the game's compact scene on mobile; this page supplies the desktop scene. */
  .hero-play :global(.ra-lobby-intro) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.5rem;
    min-height: 64px;
  }
  .hero-play :global(.ra-lobby-hero) {
    flex: 0 0 64px;
    width: 64px;
    max-width: 64px;
    height: 64px;
    overflow: hidden;
  }
  .hero-visual {
    display: none;
  }
  .category-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .category-mark {
    flex: 0 0 72px;
    width: 72px;
    height: 72px;
  }
  .category-mark :global(svg),
  .category-mark :global(img) {
    width: 72px;
    height: 72px;
  }
  @media (min-width: 960px) {
    .hero-inner {
      grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
      column-gap: 2rem;
      row-gap: 1.5rem;
      padding: 2.5rem 1.5rem 3rem;
    }
    .hero-heading {
      grid-column: 1;
    }
    .hero-play {
      grid-column: 1;
    }
    .hero-play :global(.ra-lobby-hero) {
      display: none;
    }
    .hero-play :global(.ra-lobby-intro) {
      min-height: 56px;
    }
    .hero-visual {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-self: center;
      grid-column: 2;
      grid-row: 1 / 3;
      min-width: 0;
      border: 1px solid hsl(var(--brand-light) / 0.3);
      border-radius: 12rem 12rem 2rem 2rem;
      padding: 0.5rem;
      background: hsl(var(--card) / 0.65);
      box-shadow:
        0 0 60px -15px hsl(var(--brand-light) / 0.22),
        0 20px 70px -35px hsl(var(--brand) / 0.3);
    }
    .observatory-picture {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 2 / 3;
      overflow: hidden;
      border-radius: 11.5rem 11.5rem 1.75rem 1.75rem;
    }
    .observatory-picture img {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 2 / 3;
      object-fit: cover;
    }
    .art-caption {
      padding: 1.25rem 0.5rem;
      text-align: center;
    }
    .art-caption p {
      font-family: Fraunces, serif;
      font-size: 1.25rem;
      font-weight: 700;
    }
    .art-caption span {
      display: block;
      max-width: 33ch;
      margin: 0.5rem auto 0;
      color: hsl(var(--muted-foreground));
      font-size: 0.875rem;
    }
  }
  @media (max-width: 599px) {
    /* The mode is repeated in the play card. Keep the first screen for Play. */
    .eyebrow {
      display: none;
    }
    .world-label {
      margin-bottom: 0.4rem;
      font-size: 0.625rem;
    }
    h1 {
      max-width: 25ch;
      font-size: 1.6rem;
    }
    .hero-lead {
      font-size: 0.875rem;
    }
  }
  @media (min-width: 960px) and (prefers-reduced-motion: no-preference) {
    .hero-visual {
      animation: observatory-float 9s ease-in-out infinite;
    }
  }
  @keyframes observatory-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-5px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lobby-hero :global(*) {
      animation: none !important;
      transition: none !important;
      scroll-behavior: auto !important;
    }
  }
</style>
