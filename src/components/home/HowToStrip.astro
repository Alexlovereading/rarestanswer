---
import { LOBBY, LOBBY_STEPS } from '~/lib/game/category-copy';
---

<section aria-labelledby="how-title" class="how-strip" data-pagefind-body>
  <p class="eyebrow">{LOBBY.howKicker}</p>
  <h2 id="how-title">{LOBBY.howTitle}</h2>
  <p class="section-note">{LOBBY.howNote}</p>
  <ol>
    {
      LOBBY_STEPS.map((step, index) => (
        <li>
          <div class="step-scene">
            <img
              src={`/images/world/${step.scene}-640x400.webp`}
              srcset={`/images/world/${step.scene}-640x400.webp 640w, /images/world/${step.scene}-1280x800.webp 1280w`}
              sizes="(min-width: 1040px) 320px, (min-width: 700px) calc((100vw - 80px) / 3), calc(100vw - 32px)"
              width="640"
              height="400"
              alt={step.alt}
              loading="lazy"
              decoding="async"
            />
            <span class="step-number" aria-hidden="true">
              0{index + 1}
            </span>
          </div>
          <div class="step-copy">
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .eyebrow {
    color: hsl(var(--brand-text));
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  h2 {
    margin-top: 0.35rem;
    font-size: clamp(1.65rem, 2.7vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }
  .section-note {
    margin-top: 0.75rem;
    color: hsl(var(--muted-foreground));
  }
  ol {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
    list-style: none;
    padding: 0;
  }
  li {
    position: relative;
    min-width: 0;
    overflow: hidden;
    border: 1px solid hsl(var(--border));
    border-radius: 1.5rem;
    background: hsl(var(--card));
  }
  .step-scene {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 8 / 5;
    background:
      radial-gradient(ellipse at 65% 10%, hsl(var(--gold) / 0.13), transparent 60%),
      hsl(var(--brand) / 0.08);
  }
  .step-copy {
    padding: 1.25rem;
  }
  .step-scene img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 8 / 5;
    object-fit: cover;
  }
  .step-number {
    position: absolute;
    left: 0.875rem;
    bottom: 0.875rem;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid hsl(var(--brand) / 0.2);
    border-radius: 50%;
    color: hsl(var(--foreground));
    background: hsl(var(--card));
    font-size: 0.875rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.1em;
  }
  h3 {
    font-size: 1.15rem;
    line-height: 1.3;
    font-weight: 700;
  }
  li p {
    margin-top: 0.625rem;
    font-size: 0.95rem;
    color: hsl(var(--muted-foreground));
    line-height: 1.5;
  }
  @media (min-width: 700px) {
    ol {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .how-strip *,
    .how-strip *::after {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
