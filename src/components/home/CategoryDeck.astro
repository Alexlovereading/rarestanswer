---
import { Icon } from 'astro-icon/components';
import CategoryArt from '~/components/art/CategoryArt.astro';
import {
  CATEGORY_PAGE_LIST,
  CATEGORY_HOOKS,
  LOBBY,
  type CatalogPrompt,
} from '~/lib/game/category-copy';

interface Props {
  catalog: readonly CatalogPrompt[];
}
const { catalog } = Astro.props;
---

<section id="ways" class="category-deck" aria-labelledby="category-title" data-pagefind-body>
  <header>
    <div>
      <p class="eyebrow">{LOBBY.categoryKicker}</p><h2 id="category-title">
        {LOBBY.categoryTitle}
      </h2>
    </div>
    <p class="section-note">{LOBBY.categoryNote}</p>
  </header>
  <ul class="category-grid">
    {
      CATEGORY_PAGE_LIST.map((page) => {
        const count = catalog.filter((prompt) => prompt.category === page.key).length;
        return (
          <li>
            <a href={`/trivia/${page.key}/`} class="category-tile">
              <span class="tile-count">
                {count} {LOBBY.prompts}
              </span>
              <span class="tile-art">
                <CategoryArt category={page.key} size={128} />
              </span>
              <h3>{page.label}</h3>
              <p>{CATEGORY_HOOKS[page.key]}</p>
              <Icon name="lucide:arrow-up-right" class="tile-arrow" aria-hidden="true" />
            </a>
          </li>
        );
      })
    }
  </ul>
</section>

<style>
  .category-deck {
    scroll-margin-top: 6rem;
  }
  header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    align-items: end;
  }
  .eyebrow {
    color: hsl(var(--brand-text));
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  h2 {
    margin-top: 0.35rem;
    font-size: clamp(1.65rem, 2.7vw, 2rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.025em;
  }
  .section-note {
    max-width: 36ch;
    color: hsl(var(--muted-foreground));
    font-size: 0.95rem;
  }
  .category-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    padding: 0;
    margin: 1.5rem 0 0;
    list-style: none;
  }
  li {
    min-width: 0;
  }
  .category-tile {
    position: relative;
    display: flex;
    height: 100%;
    flex-direction: column;
    align-items: center;
    padding: 0.875rem 0.5rem 1.25rem;
    border: 1px solid hsl(var(--border));
    border-radius: 1.5rem;
    background: linear-gradient(155deg, hsl(var(--brand-light) / 0.08), hsl(var(--card)) 65%);
    text-align: center;
    transition:
      transform 0.2s,
      border-color 0.2s,
      box-shadow 0.2s;
  }
  .category-tile:hover {
    transform: translateY(-4px);
    border-color: hsl(var(--brand) / 0.6);
    box-shadow: 0 10px 25px hsl(var(--brand) / 0.1);
  }
  .category-tile:focus-visible {
    outline: 3px solid hsl(var(--brand));
    outline-offset: 3px;
  }
  .tile-count {
    align-self: start;
    color: hsl(var(--muted-foreground));
    font-size: 0.75rem;
    font-weight: 600;
  }
  .tile-art {
    width: 128px;
    max-width: 100%;
    height: auto;
    aspect-ratio: 1;
    margin: 0.375rem 0 0.5rem;
    transition: transform 0.3s;
  }
  .category-tile:hover .tile-art {
    transform: rotate(-4deg) scale(1.04);
  }
  h3 {
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.25;
  }
  .category-tile p {
    margin-top: 0.35rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.8125rem;
    line-height: 1.3;
  }
  .tile-arrow {
    position: absolute;
    right: 0.7rem;
    top: 0.875rem;
    width: 15px;
    height: 15px;
    color: hsl(var(--brand-text));
  }
  @media (min-width: 640px) {
    .category-grid {
      grid-auto-flow: row;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      overflow: visible;
      gap: 1rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .category-deck *,
    .category-deck *::before {
      animation: none !important;
      transition: none !important;
      transform: none !important;
      scroll-behavior: auto !important;
    }
  }
</style>
