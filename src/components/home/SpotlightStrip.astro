---
import { Icon } from 'astro-icon/components';
import CategoryArt from '~/components/art/CategoryArt.astro';
import { answerPath, getPrompt } from '~/components/answers/prompts';
import { rarestKeywordAnchor } from '~/config/trending-prompts';
import { LOBBY, lobbySpotlights, promptNoun, type CatalogPrompt } from '~/lib/game/category-copy';
import { TIERS } from '~/lib/game/types';
interface Props {
  catalog: readonly CatalogPrompt[];
}
const { catalog } = Astro.props;
const spotlights = lobbySpotlights(catalog).map((entry) => {
  const full = getPrompt(entry.slug);
  return {
    ...entry,
    anchor: rarestKeywordAnchor(full?.nounPhrase || full?.nounTitle || promptNoun(entry.question)),
  };
});
---

{
  spotlights.length > 0 && (
    <section aria-labelledby="spotlight-title" class="spotlight-strip" data-pagefind-body>
      <div class="spotlight-heading">
        <>
          <div>
            <>
              <p class="eyebrow">
                <Icon name="lucide:sparkles" aria-hidden="true" />
                {LOBBY.spotlightKicker}
              </p>
              <h2 id="spotlight-title">{LOBBY.spotlightTitle}</h2>
            </>
          </div>
          <p>{LOBBY.spotlightNote}</p>
        </>
      </div>
      <ul>
        {spotlights.map((prompt) => (
          <li class="spotlight-card">
            <span class="spotlight-art">
              <CategoryArt category={prompt.category} size={64} decorative />
            </span>
            <div class="spotlight-content">
              <h3>
                <a class="keyword-anchor" href={answerPath(prompt.slug)}>
                  {prompt.anchor}
                </a>
              </h3>
              <p class="rare-name">{prompt.rare.name}</p>
              <span class="tier-pill" data-tier={prompt.rare.tier}>
                {TIERS.find((tier) => tier.tier === prompt.rare.tier)?.name}
              </span>
              <span class="ranking-link">
                {LOBBY.spotlightLink}
                <Icon name="lucide:arrow-right" aria-hidden="true" />
              </span>
            </div>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .spotlight-strip {
    padding: 1.5rem;
    border: 1px solid hsl(var(--brand) / 0.2);
    border-radius: 1.5rem;
    background: linear-gradient(125deg, hsl(var(--brand) / 0.07), hsl(var(--card)));
  }
  .spotlight-heading {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    align-items: end;
    justify-content: space-between;
  }
  .spotlight-heading > p {
    max-width: 38ch;
    color: hsl(var(--muted-foreground));
    font-size: 0.9rem;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: hsl(var(--brand-text));
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .eyebrow :global(svg) {
    width: 15px;
    height: 15px;
  }
  h2 {
    margin-top: 0.35rem;
    font-size: clamp(1.65rem, 2.7vw, 2rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.025em;
  }
  ul {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.5rem;
    list-style: none;
    padding: 0;
  }
  .spotlight-card {
    position: relative;
    display: flex;
    gap: 0.875rem;
    min-width: 0;
    height: 100%;
    padding: 1rem;
    border: 1px solid hsl(var(--border));
    border-radius: 1rem;
    background: hsl(var(--card));
    transition:
      border-color 0.2s,
      transform 0.2s;
  }
  .spotlight-card:hover {
    border-color: hsl(var(--brand));
    transform: translateY(-2px);
  }
  .spotlight-card:focus-within {
    outline: 3px solid hsl(var(--brand));
    outline-offset: 3px;
  }
  .keyword-anchor {
    color: inherit;
    text-decoration: none;
  }
  .keyword-anchor::after {
    content: '';
    position: absolute;
    z-index: 1;
    inset: 0;
  }
  .keyword-anchor:focus-visible {
    outline: none;
  }
  .spotlight-art {
    width: 64px;
    height: 64px;
    flex: 0 0 64px;
  }
  .spotlight-content {
    min-width: 0;
  }
  h3 {
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }
  .rare-name {
    margin-top: 0.45rem;
    color: hsl(var(--foreground));
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }
  .spotlight-content .tier-pill {
    margin-top: 0.55rem;
  }
  .ranking-link {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.8rem;
    color: hsl(var(--brand-text));
    font-size: 0.8rem;
    font-weight: 600;
  }
  .ranking-link :global(svg) {
    width: 14px;
    height: 14px;
  }
  @media (min-width: 850px) {
    ul {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .spotlight-strip * {
      animation: none !important;
      transition: none !important;
      transform: none !important;
    }
  }
</style>
