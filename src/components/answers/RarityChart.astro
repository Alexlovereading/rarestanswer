---
import TierBadge from '~/components/art/TierBadge.astro';
import { getUi } from '~/i18n/ui';
import { defaultLocale } from '~/i18n/routing';
import { TIERS } from '~/lib/game/types';
import type { PromptSeo } from './copy';

interface Props { prompt: PromptSeo }
const { prompt } = Astro.props;
const shared = getUi(defaultLocale).shared;
const labels = shared.visuals;
const rows = [...TIERS].reverse().map((tier) => ({
  ...tier,
  count: prompt.answers.filter((answer) => answer.tier === tier.tier).length,
}));
const largest = Math.max(1, ...rows.map((row) => row.count));
---

<section class="rarity-chart" aria-labelledby="rarity-distribution">
  <div class="mb-5 flex flex-wrap items-baseline justify-between gap-2">
    <h2 id="rarity-distribution" class="text-xl font-bold tracking-tight">{labels.distribution}</h2>
    <p class="text-xs text-muted-foreground">{labels.distributionTotal.replace('{count}', String(prompt.answers.length))}</p>
  </div>
  <p class="mb-5 text-sm leading-relaxed text-muted-foreground">{labels.distributionNote}</p>
  <ul class="m-0 grid list-none gap-3 p-0">
    {rows.map((row) => (
      <li class="rarity-chart__row" style={`--chart-tier: var(--tier-${row.tier})`}>
        <span class="rarity-chart__label">
          <TierBadge tier={row.tier} size={26} />
          <span>{shared.tierNames[row.tier]}</span>
        </span>
        <span class="rarity-chart__track" aria-hidden="true">
          <span class="rarity-chart__fill" style={`width: ${row.count / largest * 100}%`}></span>
        </span>
        <span class="text-right text-sm font-semibold tabular-nums">
          {row.count}<span class="sr-only"> {labels.answersLabel}</span>
        </span>
      </li>
    ))}
  </ul>
</section>
