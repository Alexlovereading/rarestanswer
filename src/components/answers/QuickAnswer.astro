---
import TierChip from './TierChip.astro';
import { formatMeasure, formatRarity, type PromptSeo } from './copy';
import { getUi } from '~/i18n/ui';
import { defaultLocale } from '~/i18n/routing';

interface Props {
  prompt: PromptSeo;
}

const { prompt } = Astro.props;
const rare = prompt.answers[0];
const common = prompt.answers[prompt.answers.length - 1];
if (!rare || !common) throw new Error(`Prompt ${prompt.slug} has no answers`);
const only = prompt.answers.length === 1;
const heading = getUi(defaultLocale).shared.quickAnswer;
---

<section aria-labelledby="quick-answer" aria-describedby="views-note">
  <h2 id="quick-answer" class="text-xl font-bold tracking-tight">{heading}</h2>
  {
    only ? (
      <aside class="glass mt-3 border-l-4 border-nav p-4">
        <p class="text-xs font-semibold uppercase tracking-wider text-foreground">Only answer</p>
        <p class="mt-1 break-words text-xl font-bold tracking-tight">{rare.name}</p>
        <div class="mt-2">
          <TierChip tier={rare.tier} />
        </div>
        <p class="mt-2 text-sm text-muted-foreground">
          {formatMeasure(rare.popularity, prompt.source)}
          <span class="mx-1" aria-hidden="true">
            ·
          </span>
          Rarity {formatRarity(rare.rarity)}
        </p>
      </aside>
    ) : (
      <div class="mt-3 grid gap-3 sm:grid-cols-2">
        <aside class="glass border-l-4 border-nav p-4">
          <p class="text-xs font-semibold uppercase tracking-wider text-foreground">Rarest</p>
          <p class="mt-1 break-words text-xl font-bold tracking-tight">{rare.name}</p>
          <div class="mt-2">
            <TierChip tier={rare.tier} />
          </div>
          <p class="mt-2 text-sm text-muted-foreground">
            {formatMeasure(rare.popularity, prompt.source)}
            <span class="mx-1" aria-hidden="true">
              ·
            </span>
            Rarity {formatRarity(rare.rarity)}
          </p>
        </aside>
        <aside class="glass p-4">
          <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Most common</p>
          <p class="mt-1 break-words text-xl font-bold tracking-tight">{common.name}</p>
          <div class="mt-2">
            <TierChip tier={common.tier} />
          </div>
          <p class="mt-2 text-sm text-muted-foreground">
            {formatMeasure(common.popularity, prompt.source)}
            <span class="mx-1" aria-hidden="true">
              ·
            </span>
            Rarity {formatRarity(common.rarity)}
          </p>
        </aside>
      </div>
    )
  }
</section>
