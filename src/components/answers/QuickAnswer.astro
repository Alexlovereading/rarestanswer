---
import TierChip from './TierChip.astro';
import TierBadge from '~/components/art/TierBadge.astro';
import { formatMeasure, isNoData, rarityPlain, type PromptSeo } from './copy';
import { getUi } from '~/i18n/ui';
import { defaultLocale } from '~/i18n/routing';

interface Props {
  prompt: PromptSeo;
}

const { prompt } = Astro.props;
const ranked = prompt.answers.filter((answer) => !isNoData(answer));
const rare = ranked[0];
const common = ranked[ranked.length - 1];
const unranked = prompt.answers.length - ranked.length;
const shared = getUi(defaultLocale).shared;
const heading = shared.quickAnswer;
const labels = shared.visuals;
---

<section aria-labelledby="quick-answer" aria-describedby="views-note">
  <h2 id="quick-answer" class="text-xl font-bold tracking-tight">{heading}</h2>
  {
    !rare || !common ? (
      <p class="mt-3 leading-relaxed text-muted-foreground">
        No answer on this prompt is ranked. None has an English Wikipedia article, so none is the rarest.
        Each is Uncommon (unranked).
      </p>
    ) : ranked.length === 1 ? (
      <aside class="answer-discovery answer-discovery--rare mt-3">
        <div class="answer-discovery__badge"><TierBadge tier={rare.tier} size={64} /></div>
        <p class="text-xs font-semibold uppercase tracking-wider text-foreground">
          {unranked === 0 ? labels.onlyAnswer : labels.rarest}
        </p>
        <p class="mt-1 break-words text-xl font-bold tracking-tight">{rare.name}</p>
        <div class="mt-2">
          <TierChip tier={rare.tier} />
        </div>
        <p class="mt-2 text-sm text-muted-foreground">
          {formatMeasure(rare.popularity, prompt.source)}
          <span class="mx-1" aria-hidden="true">
            ·
          </span>
          {rarityPlain(rare, ranked, prompt.source)}
        </p>
      </aside>
    ) : (
      <div class="mt-3 grid gap-3 sm:grid-cols-2">
        <aside class="answer-discovery answer-discovery--rare">
          <div class="answer-discovery__badge"><TierBadge tier={rare.tier} size={64} /></div>
          <p class="text-xs font-semibold uppercase tracking-wider text-foreground">{labels.rarest}</p>
          <p class="mt-1 break-words text-xl font-bold tracking-tight">{rare.name}</p>
          <div class="mt-2">
            <TierChip tier={rare.tier} />
          </div>
          <p class="mt-2 text-sm text-muted-foreground">
            {formatMeasure(rare.popularity, prompt.source)}
            <span class="mx-1" aria-hidden="true">
              ·
            </span>
            {rarityPlain(rare, ranked, prompt.source)}
          </p>
        </aside>
        <aside class="answer-discovery">
          <div class="answer-discovery__badge"><TierBadge tier={common.tier} size={64} /></div>
          <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{labels.mostCommon}</p>
          <p class="mt-1 break-words text-xl font-bold tracking-tight">{common.name}</p>
          <div class="mt-2">
            <TierChip tier={common.tier} />
          </div>
          <p class="mt-2 text-sm text-muted-foreground">
            {formatMeasure(common.popularity, prompt.source)}
            <span class="mx-1" aria-hidden="true">
              ·
            </span>
            {rarityPlain(common, ranked, prompt.source)}
          </p>
        </aside>
      </div>
    )
  }
</section>
