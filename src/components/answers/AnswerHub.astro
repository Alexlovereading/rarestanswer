---
import TierChip from './TierChip.astro';
import { HUB_TITLE, categoriesIn, categoryLabel, hubIntro, type PromptSeo } from './copy';
import { answerPath, triviaPath } from './prompts';
import { getUi } from '~/i18n/ui';
import { defaultLocale } from '~/i18n/routing';
import { CATEGORY_PAGES } from '~/lib/game/category-copy';
import { homeUrl, localizePath } from '~/lib/url';

interface Props {
  prompts: PromptSeo[];
}

const { prompts } = Astro.props;
const ui = getUi(defaultLocale);
const categories = categoriesIn(prompts);
const groups = categories.map((category) => ({
  category,
  label: categoryLabel(category),
  prompts: prompts.filter((prompt) => prompt.category === category),
}));
---

<div class="min-w-0" data-pagefind-body>
  <nav class="text-sm text-muted-foreground" aria-label={ui.shared.breadcrumbAria}>
    <a href={homeUrl(defaultLocale)} class="hover:text-nav">{ui.nav.home}</a>
    <span class="mx-1">/</span>
    <span class="text-foreground" aria-current="page">{ui.nav.rarestAnswers}</span>
  </nav>

  <h1 class="mt-3 text-3xl font-extrabold tracking-tight md:text-4xl" data-pagefind-meta={`title:${HUB_TITLE}`}>
    {HUB_TITLE}
  </h1>
  <p class="mt-4 max-w-3xl leading-relaxed">{hubIntro(prompts)}</p>

  {
    groups.length > 1 && (
      <nav class="mt-6" aria-label="Prompt categories">
        <ul class="flex list-none flex-wrap gap-2 p-0">
          {groups.map((group) => (
            <li>
              <a
                href={`#${group.category}`}
                class="inline-flex items-center gap-2 rounded-full border border-border bg-background px-3 py-1 text-sm font-semibold hover:bg-muted"
              >
                {group.label}
                <span class="tabular-nums text-muted-foreground">{group.prompts.length}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }

  {
    groups.map((group) => (
      <section
        id={group.category}
        class="mt-10 scroll-mt-20"
        aria-labelledby={`heading-${group.category}`}
      >
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <h2 id={`heading-${group.category}`} class="text-2xl font-bold tracking-tight">
            {group.label}
          </h2>
          <a class="text-sm font-medium text-nav hover:underline" href={triviaPath(group.category)}>
            {group.label} trivia
          </a>
        </div>
        <ul class="mt-4 grid list-none grid-cols-1 gap-3 p-0 sm:grid-cols-2" data-pagefind-ignore>
          {group.prompts.map((prompt) => {
            const rare = prompt.answers[0];
            return (
              <li class="min-w-0">
                <a href={answerPath(prompt.slug)} class="card block h-full p-4">
                  <h3 class="text-lg font-semibold leading-snug">{prompt.heading}</h3>
                  {rare && (
                    <p class="mt-2 text-sm text-muted-foreground">
                      Rarest answer: <span class="font-medium text-foreground">{rare.name}</span>
                    </p>
                  )}
                  <p class="mt-2 flex flex-wrap items-center gap-2 text-sm text-muted-foreground">
                    <span>
                      {prompt.answers.length === 1 ? '1 answer' : `${prompt.answers.length} answers`}
                    </span>
                    {rare && <TierChip tier={rare.tier} />}
                  </p>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    ))
  }

  <nav class="mt-10" aria-label={ui.shared.keepExploring}>
    <h2 class="text-xl font-bold tracking-tight">{ui.shared.keepExploring}</h2>
    <ul class="mt-3 grid list-none gap-2 p-0 sm:grid-cols-2">
      <li>
        <a class="block rounded-lg border bg-card px-4 py-3 text-sm font-medium text-nav hover:border-nav" href={homeUrl(defaultLocale)}>{ui.nav.play}</a>
      </li>
      <li>
        <a class="block rounded-lg border bg-card px-4 py-3 text-sm font-medium text-nav hover:border-nav" href={localizePath('/unlimited/', defaultLocale)}>{ui.nav.unlimited}</a>
      </li>
      <li>
        <a class="block rounded-lg border bg-card px-4 py-3 text-sm font-medium text-nav hover:border-nav" href={localizePath('/trivia/animals/', defaultLocale)}>{CATEGORY_PAGES.animals.h1}</a>
      </li>
      <li>
        <a class="block rounded-lg border bg-card px-4 py-3 text-sm font-medium text-nav hover:border-nav" href={localizePath('/games/', defaultLocale)}>{ui.nav.games}</a>
      </li>
      <li>
        <a class="block rounded-lg border bg-card px-4 py-3 text-sm font-medium text-nav hover:border-nav" href={localizePath('/guides/', defaultLocale)}>{ui.nav.guides}</a>
      </li>
    </ul>
  </nav>
</div>
