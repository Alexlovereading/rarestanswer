---
import TierChip from './TierChip.astro';
import { getUi } from '~/i18n/ui';
import { defaultLocale } from '~/i18n/routing';
import { formatViews, rarityShort, wikipediaUrl, type PromptSeo } from './copy';

interface Props {
  prompt: PromptSeo;
}

const { prompt } = Astro.props;
const labels = getUi(defaultLocale).shared.visuals;
---

<section aria-labelledby="ranked-answers">
  <h2 id="ranked-answers" class="text-xl font-bold tracking-tight">{labels.rankedAnswers}</h2>
  <div
    class="answer-ranking mt-3 overflow-x-auto"
    tabindex="0"
    role="region"
    aria-label={labels.rankedRegion}
  >
    <table class="w-full min-w-[40rem] border-collapse text-sm">
      <caption class="caption-top mb-2 text-left text-sm text-muted-foreground">
        {prompt.tableCaption}
      </caption>
      <thead>
        <tr class="border-b border-border text-left text-xs font-semibold uppercase tracking-wide text-muted-foreground">
          <th scope="col" class="px-3 py-2 font-semibold">{labels.rank}</th>
          <th scope="col" class="px-3 py-2 font-semibold">{labels.answer}</th>
          <th scope="col" class="px-3 py-2 font-semibold">{labels.tier}</th>
          <th scope="col" class="px-3 py-2 text-right font-semibold">{labels.rarity}</th>
          <th
            scope="col"
            class="whitespace-nowrap px-3 py-2 text-right font-semibold"
            aria-describedby="views-note"
          >
            {prompt.viewsHeading}
          </th>
        </tr>
      </thead>
      <tbody>
        {
          prompt.answers.map((answer, index) => (
            <tr class="answer-ranking__row border-b border-border last:border-0" data-tier={answer.tier}>
              <td class="px-3 py-2 tabular-nums text-muted-foreground" data-rank={index + 1}>{index + 1}</td>
              <th scope="row" class="px-3 py-2 text-left font-medium">
                {answer.wiki ? (
                  <a class="text-nav hover:underline" href={wikipediaUrl(answer.wiki)}>
                    {answer.name}
                    <span class="sr-only">{labels.onWikipedia}</span>
                  </a>
                ) : (
                  answer.name
                )}
              </th>
              <td class="px-3 py-2">
                <TierChip tier={answer.tier} art={index < 3} />
              </td>
              <td class="px-3 py-2 text-right">{rarityShort(answer, prompt.answers)}</td>
              <td class="whitespace-nowrap px-3 py-2 text-right tabular-nums">
                {formatViews(answer.popularity)}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>
