---
import TierChip from './TierChip.astro';
import { getUi } from '~/i18n/ui';
import { defaultLocale } from '~/i18n/routing';
import { formatViews, isNoData, rarityShort, wikipediaUrl, type PromptSeo } from './copy';

interface Props {
  prompt: PromptSeo;
}

const { prompt } = Astro.props;
const labels = getUi(defaultLocale).shared.visuals;
const ranked = prompt.answers.filter((answer) => !isNoData(answer));
let rank = 0;
const rows = prompt.answers.map((answer) => {
  const unranked = isNoData(answer);
  if (!unranked) rank += 1;
  return { answer, unranked, rank: unranked ? null : rank };
});
const regionLabel = prompt.noDataNote
  ? 'Ranked answers, then answers with no Wikipedia article'
  : labels.rankedRegion;
---

<section aria-labelledby="ranked-answers">
  <h2 id="ranked-answers" class="text-xl font-bold tracking-tight">{labels.rankedAnswers}</h2>
  {
    prompt.noDataNote && (
      <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{prompt.noDataNote}</p>
    )
  }
  <div
    class="answer-ranking mt-3 overflow-x-auto"
    tabindex="0"
    role="region"
    aria-label={regionLabel}
  >
    <table class="w-full min-w-[52rem] border-collapse text-sm">
      <caption class="caption-top mb-2 text-left text-sm text-muted-foreground">
        {prompt.tableCaption}
      </caption>
      <thead>
        <tr class="border-b border-border text-left text-xs font-semibold uppercase tracking-wide text-muted-foreground">
          <th scope="col" class="px-3 py-2 font-semibold">{labels.rank}</th>
          <th scope="col" class="px-3 py-2 font-semibold">{labels.answer}</th>
          <th scope="col" class="px-3 py-2 font-semibold">{labels.tier}</th>
          <th scope="col" class="px-3 py-2 text-right font-semibold">{labels.rarity}</th>
          <th scope="col" class="px-3 py-2 text-right font-semibold" aria-describedby="views-note">
            {prompt.viewsHeading}
          </th>
          <th scope="col" class="px-3 py-2 font-semibold">Wikipedia article</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row) => (
            <tr class="answer-ranking__row border-b border-border last:border-0" data-tier={row.unranked ? 3 : row.answer.tier}>
              <td class="px-3 py-2 tabular-nums text-muted-foreground" data-rank={row.rank ?? undefined}>
                {row.rank ?? '—'}
              </td>
              <th scope="row" class="px-3 py-2 text-left font-medium">
                {row.answer.name}
              </th>
              <td class="px-3 py-2">
                {row.unranked ? (
                  <TierChip tier={3} label="Uncommon (unranked)" />
                ) : (
                  <TierChip tier={row.answer.tier} art />
                )}
              </td>
              <td class="px-3 py-2 text-right">
                {row.unranked ? 'Unranked' : rarityShort(row.answer, ranked, prompt.source)}
              </td>
              <td class="whitespace-nowrap px-3 py-2 text-right tabular-nums">
                {row.unranked ? 'No article' : formatViews(row.answer.popularity)}
              </td>
              <td class="px-3 py-2">
                {row.answer.wiki ? (
                  <a class="text-nav hover:underline" href={wikipediaUrl(row.answer.wiki)}>
                    {row.answer.wiki}
                  </a>
                ) : (
                  <span class="text-muted-foreground">—</span>
                )}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>
