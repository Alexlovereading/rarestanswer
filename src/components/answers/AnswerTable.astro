---
import TierChip from './TierChip.astro';
import { getUi } from '~/i18n/ui';
import { defaultLocale } from '~/i18n/routing';
import {
  formatViews,
  isNoData,
  measureKind,
  rarityShort,
  wikipediaUrl,
  type PromptSeo,
  type SeoAnswer,
} from './copy';

interface Props {
  prompt: PromptSeo;
}

interface SourceLink {
  href: string;
  label: string;
}

const { prompt } = Astro.props;
const labels = getUi(defaultLocale).shared.visuals;
const ranked = prompt.answers.filter((answer) => !isNoData(answer));
const kind = measureKind(prompt.source);
let rank = 0;
const rows = prompt.answers.map((answer) => {
  const unranked = isNoData(answer);
  if (!unranked) rank += 1;
  return { answer, unranked, rank: unranked ? null : rank, sources: sourceLinks(answer, kind) };
});
const hasWiki = prompt.answers.some((answer) => Boolean(answer.wiki));
const hasQid = rows.some((row) => row.sources.some((link) => link.kind === 'wikidata'));
const sourceHeading =
  kind === 'wiktionary' && !hasWiki && !hasQid
    ? 'Wiktionary entry'
    : hasQid || kind === 'wiktionary'
      ? 'Source'
      : 'Wikipedia article';
const regionLabel = prompt.noDataNote
  ? 'Ranked answers, then answers with no Wikipedia article'
  : labels.rankedRegion;

/** English Wikipedia title, or the Wiktionary lemma this prompt measured. */
function entryUrl(title: string, host: 'en.wikipedia.org' | 'en.wiktionary.org'): string {
  const slug = encodeURIComponent(title.trim().replace(/ /g, '_'));
  return `https://${host}/wiki/${slug}`;
}

/** Q123 only. A missing or non-Q id is not a link. */
function qidOf(answer: SeoAnswer): string | null {
  const extra = answer as SeoAnswer & { qid?: unknown; wikidata?: unknown };
  for (const raw of [extra.qid, extra.wikidata]) {
    if (typeof raw !== 'string') continue;
    const id = raw.trim().replace(/^https?:\/\/www\.wikidata\.org\/(?:wiki|entity)\//i, '');
    if (/^Q\d+$/.test(id)) return id;
  }
  return null;
}

function sourceLinks(answer: SeoAnswer, measured: ReturnType<typeof measureKind>): Array<SourceLink & { kind: string }> {
  const links: Array<SourceLink & { kind: string }> = [];
  if (answer.wiki) {
    links.push({ kind: 'wikipedia', href: wikipediaUrl(answer.wiki), label: answer.wiki });
  }
  if (measured === 'wiktionary' && !isNoData(answer)) {
    const title = answer.name.trim();
    if (title) {
      links.push({
        kind: 'wiktionary',
        href: entryUrl(title, 'en.wiktionary.org'),
        label: answer.wiki ? `${title} on Wiktionary` : title,
      });
    }
  }
  const qid = qidOf(answer);
  if (qid) {
    links.push({ kind: 'wikidata', href: `https://www.wikidata.org/wiki/${qid}`, label: qid });
  }
  return links;
}
---

<section aria-labelledby="ranked-answers">
  <h2 id="ranked-answers" class="text-xl font-bold tracking-tight">{labels.rankedAnswers}</h2>
  {
    prompt.noDataNote && (
      <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{prompt.noDataNote}</p>
    )
  }
  <div
    class="answer-ranking mt-3 overflow-x-auto"
    tabindex="0"
    role="region"
    aria-label={regionLabel}
  >
    <table class="w-full min-w-[52rem] border-collapse text-sm">
      <caption class="caption-top mb-2 text-left text-sm text-muted-foreground">
        {prompt.tableCaption}
      </caption>
      <thead>
        <tr class="border-b border-border text-left text-xs font-semibold uppercase tracking-wide text-muted-foreground">
          <th scope="col" class="px-3 py-2 font-semibold">{labels.rank}</th>
          <th scope="col" class="px-3 py-2 font-semibold">{labels.answer}</th>
          <th scope="col" class="px-3 py-2 font-semibold">{labels.tier}</th>
          <th scope="col" class="px-3 py-2 text-right font-semibold">{labels.rarity}</th>
          <th scope="col" class="px-3 py-2 text-right font-semibold" aria-describedby="views-note">
            {prompt.viewsHeading}
          </th>
          <th scope="col" class="px-3 py-2 font-semibold">{sourceHeading}</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row) => (
            <tr class="answer-ranking__row border-b border-border last:border-0" data-tier={row.unranked ? 3 : row.answer.tier}>
              <td class="px-3 py-2 tabular-nums text-muted-foreground" data-rank={row.rank ?? undefined}>
                {row.rank ?? '—'}
              </td>
              <th scope="row" class="px-3 py-2 text-left font-medium">
                {row.answer.name}
              </th>
              <td class="px-3 py-2">
                {row.unranked ? (
                  <TierChip tier={3} label="Uncommon (unranked)" />
                ) : (
                  <TierChip tier={row.answer.tier} art />
                )}
              </td>
              <td class="px-3 py-2 text-right">
                {row.unranked ? 'Unranked' : rarityShort(row.answer, ranked, prompt.source)}
              </td>
              <td class="whitespace-nowrap px-3 py-2 text-right tabular-nums">
                {row.unranked ? 'No article' : formatViews(row.answer.popularity)}
              </td>
              <td class="px-3 py-2">
                {row.sources.length === 0 ? (
                  <span class="text-muted-foreground">—</span>
                ) : (
                  row.sources.map((link) => (
                    <a class="answer-source text-nav hover:underline" href={link.href}>
                      {link.label}
                    </a>
                  ))
                )}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>

<style>
  .answer-source + .answer-source {
    margin-inline-start: 0.75rem;
  }
</style>
