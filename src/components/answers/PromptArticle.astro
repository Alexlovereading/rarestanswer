---
import { Icon } from 'astro-icon/components';
import AnswerFaq from './AnswerFaq.astro';
import AnswerTable from './AnswerTable.astro';
import QuickAnswer from './QuickAnswer.astro';
import RarityChart from './RarityChart.astro';
import CategoryArt from '~/components/art/CategoryArt.astro';
import TierBadge from '~/components/art/TierBadge.astro';
import { categoryLabel, isNoData, reportAnswerHref, type PromptSeo } from './copy';
import {
  HUB_PATH,
  answerPath,
  hubCategoryPath,
  playPath,
  relatedPrompts,
  triviaPath,
} from './prompts';
import { getUi } from '~/i18n/ui';
import { defaultLocale } from '~/i18n/routing';
import { homeUrl, localizePath } from '~/lib/url';

interface Props {
  prompt: PromptSeo;
}

const { prompt } = Astro.props;
const ui = getUi(defaultLocale);
const labels = ui.shared.visuals;
const label = categoryLabel(prompt.category);
const shown = relatedPrompts(prompt);
const mixed = shown.some((item) => item.category !== prompt.category);
const relatedTitle = mixed ? labels.relatedPrompts : labels.morePrompts.replace('{category}', label);
const pagefindTitle = prompt.heading.replace(/:/g, ' -');
---

<article
  class="mx-auto min-w-0 max-w-3xl"
  data-pagefind-body
  data-pagefind-meta={`title:${pagefindTitle}`}
>
  <nav class="text-sm text-muted-foreground" aria-label={ui.shared.breadcrumbAria}>
    <a href={homeUrl(defaultLocale)} class="hover:text-nav">{ui.nav.home}</a>
    <span class="mx-1">/</span>
    <a href={HUB_PATH} class="hover:text-nav">{ui.nav.rarestAnswers}</a>
    <span class="mx-1">/</span>
    <span class="break-words text-foreground" aria-current="page">{prompt.crumb}</span>
  </nav>

  <header class="content-band prompt-observatory mt-5">
    <div class="min-w-0">
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-nav">
        <a class="hover:underline" href={hubCategoryPath(prompt.category)}>{label}</a>
      </p>
      <h1 class="mt-2 text-3xl font-extrabold tracking-tight md:text-4xl">{prompt.heading}</h1>
      <p class="mt-4 leading-relaxed text-muted-foreground">{prompt.intro}</p>
      <a class="btn-primary mt-5 min-h-11 gap-2" href={playPath(prompt.slug)}>
        <Icon name="lucide:play" class="h-4 w-4" aria-hidden="true" />
        {labels.playPrompt}
      </a>
    </div>
    <div class="content-band__art">
      <CategoryArt category={prompt.category} size={208} />
    </div>
  </header>

  {
    prompt.guide.length > 0 && (
      <div class="mt-8 flex flex-col gap-4 leading-relaxed">
        {prompt.guide.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    )
  }

  <div class="mt-10">
    <QuickAnswer prompt={prompt} />
  </div>
  <p id="views-note" class="mt-3 text-sm leading-relaxed text-muted-foreground">{prompt.viewsNote}</p>
  {
    prompt.dataUpdated && (
      <p class="mt-2 text-sm font-medium text-foreground">{prompt.dataUpdated}</p>
    )
  }
  <p class="mt-3 text-sm">
    <a class="text-nav hover:underline" href={reportAnswerHref(prompt.slug)}>Report a wrong answer</a>
    <span class="mx-2 text-muted-foreground" aria-hidden="true">·</span>
    <a class="text-nav hover:underline" href={localizePath('/data-updates', defaultLocale)}>Data updates</a>
  </p>

  <div class="mt-8">
    <RarityChart prompt={prompt} />
  </div>

  <div class="mt-10">
    <AnswerTable prompt={prompt} />
  </div>

  <div class="mt-10">
    <AnswerFaq items={prompt.faq} />
  </div>

  <section class="play-cta prompt-play-cta mt-10" aria-labelledby="play-prompt">
    <div class="prompt-play-cta__badge"><TierBadge tier={6} size={96} /></div>
    <div class="min-w-0 flex-1">
    <h2 id="play-prompt" class="text-xl font-bold tracking-tight">{labels.play}</h2>
    <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
      {labels.playPromptNote}
    </p>
    <div class="mt-4 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
      <a class="btn-primary gap-2" href={playPath(prompt.slug)}>
        <Icon name="lucide:play" class="h-4 w-4" aria-hidden="true" />
        {labels.playPrompt}
      </a>
      <a class="btn-outline gap-2" href={triviaPath(prompt.category)}>
        <Icon name="lucide:list" class="h-4 w-4" aria-hidden="true" />
        {labels.categoryTrivia.replace('{category}', label)}
      </a>
      <a class="btn-outline gap-2" href={localizePath('/games/', defaultLocale)}>{ui.nav.games}</a>
      <a class="btn-outline gap-2" href={localizePath('/guides/', defaultLocale)}>{ui.nav.guides}</a>
    </div>
    </div>
  </section>

  <section class="mt-10" aria-labelledby="related-prompts">
    <h2 id="related-prompts" class="text-xl font-bold tracking-tight">{relatedTitle}</h2>
    {
      shown.length > 0 ? (
        <ul class="mt-3 grid list-none gap-2 p-0 sm:grid-cols-2">
          {shown.map((item) => {
            const rare = item.answers.find((answer) => !isNoData(answer));
            return (
              <li class="min-w-0">
                <a
                  href={answerPath(item.slug)}
                  class="card illustrated-prompt-card h-full hover:border-nav/40"
                >
                  <div class="illustrated-prompt-card__art"><CategoryArt category={item.category} size={64} decorative /></div>
                  <div class="min-w-0">
                  {mixed && (
                    <span class="text-xs font-semibold uppercase tracking-wide text-nav">
                      {categoryLabel(item.category)}
                    </span>
                  )}
                  <span class="block font-display text-lg font-semibold leading-snug">{item.question}</span>
                  {rare && (
                    <span class="mt-1 block text-sm text-muted-foreground">
                      {labels.rarestAnswer} {rare.name}
                    </span>
                  )}
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      ) : (
        <p class="mt-3 text-sm text-muted-foreground">{labels.noOtherPrompts.replace('{category}', label)}</p>
      )
    }
    <p class="mt-3 text-sm">
      <a class="text-nav hover:underline" href={hubCategoryPath(prompt.category)}>
        {labels.allPrompts.replace('{category}', label)}
      </a>
    </p>
  </section>

  <section class="mt-10" aria-labelledby="sources">
    <h2 id="sources" class="text-xl font-bold tracking-tight">{labels.sources}</h2>
    <p class="mt-3 text-sm leading-relaxed">{prompt.sourceNote}</p>
    <ul class="mt-3 flex list-none flex-col gap-1 p-0 text-sm">
      <li>
        <a class="text-nav hover:underline" href="https://www.wikidata.org/">Wikidata</a>
      </li>
      <li>
        <a class="text-nav hover:underline" href="https://en.wikipedia.org/">English Wikipedia</a>
      </li>
    </ul>
  </section>
</article>

<style>
  .prompt-observatory .content-band__art {
    width: 176px;
    height: 176px;
    filter: drop-shadow(0 12px 20px hsl(var(--brand) / 0.15));
  }
  @media (min-width: 640px) {
    .prompt-observatory {
      grid-template-columns: minmax(0, 1fr) 208px;
    }
    .prompt-observatory .content-band__art {
      width: 208px;
      height: 208px;
    }
  }
</style>
