{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
    "exclude": [
      "dist",
      "tools",
      "tests/community-digest.test.ts",
      "tests/landing-paths.test.ts"
    ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "~/*": ["src/*"]
    },
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "jsx": "preserve"
  }
}
